# Copy to devtools/publish.env and fill in. The real file is gitignored.

# AWS CLI profile with access to the public.ecr.aws/zenml Helm registry.
AWS_PROFILE=

# Registry prefix the server and worker images are pushed to, for example a
# Docker Hub namespace or an ECR registry URL. The images are named
# <prefix>/kitaru-server and <prefix>/kitaru-worker.
IMAGE_REPOSITORY_PREFIX=

# ZenML Pro user and organization that own the created workspace.
OWNER_ID=
ORGANIZATION_ID=

# Only needed with --deploy. Defaults target staging.
ZENML_PRO_PAT=
# ZENML_PRO_URL=https://staging.cloud.zenml.io
# ZENML_PRO_API_URL=https://staging.cloudapi.zenml.io

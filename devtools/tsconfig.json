{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // Off so `report` objects can gain fields after creation and fixture
    // callbacks need no JSDoc; values typed by Kitaru's packages stay checked.
    "noImplicitAny": false,
    "types": ["node"]
  },
  "include": ["**/*.mjs"]
}

# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Scripts in this example load .env automatically via python-dotenv.

# Required — used by the support copilot flow (openai:gpt-5-mini / gpt-5-nano).
OPENAI_API_KEY=sk-...

# Optional — override the primary execution ID (default: first line of fixtures/prod_exec_ids).
# PROD_ID=kr-...

# Optional — comma-separated execution IDs for batch scenarios (default: all lines in fixtures/prod_exec_ids).
# PROD_IDS=kr-...,kr-...

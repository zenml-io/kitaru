# Kitaru server used by the document-processing example.
KITARU_API_URL=http://localhost:8000
KITARU_API_KEY=
KITARU_USERNAME=default
KITARU_PASSWORD=password

# Required for candidate replay and fresh baseline generation.
OPENAI_API_KEY=
BASELINE_MODEL=openai:gpt-5-nano
CANDIDATE_MODEL=openai:gpt-5-mini

# Required only with --bootstrap-traces.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

{
  "name": "@zenml-io/kitaru",
  "version": "0.1.0-rc.2",
  "description": "TypeScript SDK and adapter foundation for Kitaru agent tracing and replay",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenml-io/kitaru.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/zenml-io/kitaru#readme",
  "bugs": {
    "url": "https://github.com/zenml-io/kitaru/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "import": "./dist/adapter/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kitaru",
    "zenml",
    "agents",
    "tracing",
    "replay",
    "typescript-sdk"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-typescript-dist.mjs && tsc -p tsconfig.build.json",
    "generate": "node scripts/generate-openapi.mjs",
    "generate:check": "node scripts/generate-openapi.mjs --check",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

{
  "name": "@zenml-io/kitaru-vercel-ai",
  "version": "0.1.0-experimental.0",
  "description": "Experimental Kitaru tracing and replay adapter for the Vercel AI SDK",
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kitaru",
    "zenml",
    "agents",
    "tracing",
    "replay",
    "vercel-ai-sdk"
  ],
  "dependencies": {
    "@zenml-io/kitaru": "workspace:0.1.0-experimental.0"
  },
  "peerDependencies": {
    "ai": ">=7.0.0 <8.0.0"
  },
  "devDependencies": {
    "ai": "7.0.55"
  },
  "scripts": {
    "build": "node ../../scripts/clean-typescript-dist.mjs && tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

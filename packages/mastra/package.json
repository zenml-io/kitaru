{
  "name": "@zenml-io/kitaru-mastra",
  "version": "0.1.0-rc.1",
  "description": "Mastra adapter for Kitaru agent tracing and replay",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenml-io/kitaru.git",
    "directory": "packages/mastra"
  },
  "homepage": "https://github.com/zenml-io/kitaru#readme",
  "bugs": {
    "url": "https://github.com/zenml-io/kitaru/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kitaru",
    "zenml",
    "agents",
    "tracing",
    "replay",
    "mastra"
  ],
  "dependencies": {
    "@zenml-io/kitaru": "workspace:0.1.0-rc.1"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.51.0 <1.52.0"
  },
  "devDependencies": {
    "@mastra/core": "1.51.0",
    "zod": "3.25.76"
  },
  "scripts": {
    "build": "node ../../scripts/clean-typescript-dist.mjs && tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const DEFAULT_OG_IMAGE = 'https://assets.kitaru.ai/content/site/dee725d9/kitaru-og.png';

const {
  title = 'Kitaru | The Platform Layer for Autonomous AI Agents',
  description = 'Open-source platform layer for Python agents. Works with the OpenAI Agents SDK, Anthropic Agent SDK, or any framework. Checkpointed execution, human-in-the-loop, versioned artifacts, and deployment on any cloud.',
  ogImage = DEFAULT_OG_IMAGE,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#f8f6f3" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <title>{title}</title>
  <meta name="description" content={description} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <slot name="head" />
  <noscript><style>
    [data-reveal], .feature-card, .why-card { opacity: 1 !important; transform: none !important; position: relative !important; top: auto !important; }
  </style></noscript>

  <!-- Preconnect origins used during initial load -->
  <link rel="preconnect" href="https://plausible.io" />
  <link rel="preconnect" href="https://assets.kitaru.ai" />
  <!-- DNS-prefetch only for deferred analytics (full preconnect would idle-timeout) -->
  <link rel="dns-prefetch" href="https://cdn.segment.com" />
  <link rel="dns-prefetch" href="https://b2bjsstore.s3.us-west-2.amazonaws.com" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,300&family=DM+Serif+Display&family=JetBrains+Mono:wght@400;500&display=swap"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,300&family=DM+Serif+Display&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Kitaru",
    "url": "https://kitaru.ai",
    "description": "Open-source platform layer for autonomous AI agents. Works with the OpenAI Agents SDK, Anthropic Agent SDK, or any framework."
  }
  </script>
  <!-- Plausible Analytics -->
  <script is:inline async src="https://plausible.io/js/pa-ndWEQcsUsU-PbMUClN4jg.js"></script>
  <script is:inline>
    window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
    plausible.init()
  </script>
  <!-- Segment Analytics + RB2B (deferred to avoid blocking first paint) -->
  <script is:inline>
    (function () {
      function loadAnalytics() {
        // Segment
        !function(){var i="analytics",analytics=window[i]=window[i]||[];if(!analytics.initialize)if(analytics.invoked)window.console&&console.error&&console.error("Segment snippet included twice.");else{analytics.invoked=!0;analytics.methods=["trackSubmit","trackClick","trackLink","trackForm","pageview","identify","reset","group","track","ready","alias","debug","page","screen","once","off","on","addSourceMiddleware","addIntegrationMiddleware","setAnonymousId","addDestinationMiddleware","register"];analytics.factory=function(e){return function(){if(window[i].initialized)return window[i][e].apply(window[i],arguments);var n=Array.prototype.slice.call(arguments);if(["track","screen","alias","group","page","identify"].indexOf(e)>-1){var c=document.querySelector("link[rel='canonical']");n.push({__t:"bpc",c:c&&c.getAttribute("href")||void 0,p:location.pathname,u:location.href,s:location.search,t:document.title,r:document.referrer})}n.unshift(e);analytics.push(n);return analytics}};for(var n=0;n<analytics.methods.length;n++){var key=analytics.methods[n];analytics[key]=analytics.factory(key)}analytics.load=function(key,n){var t=document.createElement("script");t.type="text/javascript";t.async=!0;t.setAttribute("data-global-segment-analytics-key",i);t.src="https://cdn.segment.com/analytics.js/v1/" + key + "/analytics.min.js";var r=document.getElementsByTagName("script")[0];r.parentNode.insertBefore(t,r);analytics._loadOptions=n};analytics._writeKey="MMarT0XoV4LJH8wR7wpmkTbF7txc9Bsg";;analytics.SNIPPET_VERSION="5.2.0";
        analytics.load("MMarT0XoV4LJH8wR7wpmkTbF7txc9Bsg");
        analytics.page();
        }}();
        // RB2B
        !function(key) {
          if (window.reb2b) return;
          window.reb2b = {loaded: true};
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://b2bjsstore.s3.us-west-2.amazonaws.com/b/" + key + "/" + key + ".js.gz";
          document.getElementsByTagName("script")[0].parentNode.insertBefore(s, document.getElementsByTagName("script")[0]);
        }("Z6PVLHP07Q6R");
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadAnalytics, { timeout: 3000 });
      } else {
        setTimeout(loadAnalytics, 2000);
      }
    })();
  </script>
</head>
<body>
  <img referrerpolicy="no-referrer-when-downgrade" src="https://static.scarf.sh/a.png?x-pxid=ed00dfa6-5202-4c95-a38f-d8c066bdcc71" alt="" aria-hidden="true" width="1" height="1" style="position:absolute" />
  <a href="#main-content" class="skip-link">Skip to content</a>
  <slot />

  <!-- DEBUG: light/dark preview toggle. Remove before shipping to production. -->
  <button id="debug-theme-toggle" type="button" aria-label="Toggle light/dark preview">
    <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
    <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
  </button>
  <script is:inline>
    (function () {
      const root = document.documentElement;
      const stored = localStorage.getItem('debug-theme');
      if (stored === 'dark') root.classList.add('debug-dark');
      const btn = document.getElementById('debug-theme-toggle');
      btn?.addEventListener('click', () => {
        const next = root.classList.toggle('debug-dark');
        localStorage.setItem('debug-theme', next ? 'dark' : 'light');
      });
    })();
  </script>
  <style is:global>
    /* DEBUG-ONLY dark preview. Swaps the core tokens so designers can sanity-
       check sections in dark mode without a full theming pass. Remove with the
       toggle button above when design work wraps. */
    #debug-theme-toggle {
      position: fixed;
      top: 16px;
      right: 16px;
      z-index: 9999;
      width: 38px;
      height: 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-primary);
      cursor: pointer;
      box-shadow: 0 2px 8px oklch(0 0 0 / 0.08);
    }
    #debug-theme-toggle:hover { border-color: var(--color-accent); }
    #debug-theme-toggle .moon { display: none; }
    .debug-dark #debug-theme-toggle .sun { display: none; }
    .debug-dark #debug-theme-toggle .moon { display: block; }

    html.debug-dark {
      color-scheme: dark;
      /* Token scale is inverted: body is the darkest layer, --color-bg is the
         "card" layer (one step up), --color-surface is the "raised" layer. This
         mirrors the light-mode intent where cards use var(--color-bg) against
         a near-white page — swapping the whole stack keeps the visual
         hierarchy intact. */
      --color-page-bg: oklch(0.13 0.012 60);
      --color-bg: oklch(0.2 0.012 60);
      --color-surface: oklch(0.24 0.012 60);
      --color-surface-warm: oklch(0.26 0.015 70);
      --color-surface-subtle: oklch(0.22 0.01 60);
      --color-primary: oklch(0.95 0.01 70);
      --color-secondary: oklch(0.78 0.01 70);
      --color-muted: oklch(0.62 0.01 70);
      --color-border: oklch(0.32 0.015 65);
      --color-border-light: oklch(0.28 0.012 65);
      --color-border-accent: oklch(0.45 0.08 60);
      --color-accent-light: oklch(0.32 0.06 55);
    }
    html.debug-dark body {
      background: var(--color-page-bg);
      color: var(--color-primary);
    }

    /* Override page/region backgrounds that use hardcoded light values. The
       compare page's scoped style is specificity (0,2,1) via Astro's data-astro-cid
       attribute; we match that with html.debug-dark so the cascade picks the
       later rule. */
    html.debug-dark .compare-page,
    html.debug-dark main {
      background: var(--color-page-bg);
    }

    /* Nav has a hardcoded cream-white sticky bg on .nav.scrolled — swap to
       translucent dark. Use !important because the scoped style has equal or
       higher specificity after Astro's data-astro-cid attribute is added. */
    html.debug-dark .nav,
    html.debug-dark .nav.scrolled {
      background: oklch(0.2 0.012 60 / 0.92) !important;
      border-bottom-color: var(--color-border) !important;
    }
    html.debug-dark .nav-mobile-menu {
      background: var(--color-bg) !important;
      border-color: var(--color-border) !important;
    }

    /* CTA sections (homepage .cta-section + comparison .ccta-section) use
       --color-primary as bg — in light mode that's the dark contrast band. In
       dark mode --color-primary flips to near-white which inverts the intent.
       Lock the whole section (and its ::before radial overlay) to extra-dark. */
    html.debug-dark .cta-section,
    html.debug-dark .ccta-section {
      background: oklch(0.08 0.015 60) !important;
      color: oklch(0.95 0.01 70);
    }
    /* The ::before pseudo-element paints a radial gradient of --color-primary
       over the section. In dark mode that becomes a huge cream glow — kill it
       or swap it to a dark radial so the mesh blobs stay the only highlight. */
    html.debug-dark .cta-section::before,
    html.debug-dark .ccta-section::before {
      background: radial-gradient(ellipse 70% 80% at 50% 50%, oklch(0.08 0.015 60) 0%, transparent 100%) !important;
    }

    /* .btn-primary uses --color-primary bg + pure-white text. In dark mode bg
       flips to near-white, rendering the button invisible. Swap to the accent
       so the primary CTA stays visible and on-brand. */
    html.debug-dark .btn-primary {
      background: var(--color-accent-darker) !important;
      color: oklch(1 0 0) !important;
    }

    /* Homepage Features section has a fixed-image cream bg loaded from R2 —
       hide the image in dark preview so the dark body bg shows through. */
    html.debug-dark .features-section {
      background: var(--color-bg) !important;
    }
    html.debug-dark .features-section.bg-loaded {
      background-image: none !important;
    }

    /* Competitor logos are dark-stroke SVGs designed for light backgrounds —
       invert them in dark mode so they read against the dark surface. */
    html.debug-dark img[src^="/compare/"],
    html.debug-dark img[src*="compare/dbos"],
    html.debug-dark img[src*="compare/temporal"],
    html.debug-dark img[src*="compare/restate"],
    html.debug-dark img[src*="compare/pydantic-ai"],
    html.debug-dark img[src*="compare/langgraph"],
    html.debug-dark img[src*="compare/claude-agent-sdk"] {
      filter: invert(1) hue-rotate(180deg);
    }

    /* Footer: ensure tokens show through any hardcoded light bg. */
    html.debug-dark .footer,
    html.debug-dark footer {
      background: var(--color-bg);
      color: var(--color-secondary);
      border-top: 1px solid var(--color-border);
    }

    /* Tables: surface-warm header + surface rows flip cleanly, but force the
       text color so any inline inheritance from parent wrappers doesn't leak. */
    html.debug-dark .compare-body-inner table,
    html.debug-dark .compare-body-inner td,
    html.debug-dark .compare-body-inner th {
      color: var(--color-secondary);
    }
    html.debug-dark .compare-body-inner th,
    html.debug-dark .compare-body-inner td:first-child {
      color: var(--color-primary);
    }

    /* WhenToUseEach / compare cards use var(--color-bg) + hardcoded white
       text colors inside .when-card--kitaru — the oklch(1 0 0) would clash
       with the already-dark card bg in dark mode. Keep as-is; accent pill
       (--color-accent-darker) is orange and reads fine. */

    /* Any section that layers a hardcoded oklch(0.985 0.003 90/X) background
       (e.g. testimonial cards, partner logos) — broad catch-all that fades
       them to surface-warm in dark. */
    html.debug-dark [style*="oklch(0.985"] { background: var(--color-surface-warm) !important; }

    /* CodeCompare / Shiki syntax theme stays light (acceptable for debug). */
  </style>

  <script src="../scripts/scroll-reveal.ts"></script>
  <script is:inline>
    console.log(
      '%c@flow %c— durable execution for Python agents',
      'color: #F17829; font-weight: bold; font-size: 14px;',
      'color: inherit; font-size: 14px;'
    );
    console.log(
      '%cpip install kitaru %c· https://github.com/zenml-io/kitaru',
      'color: #F17829; font-family: monospace;',
      'color: gray;'
    );
  </script>
</body>
</html>

---
interface Section {
  id: string;
  label: string;
}

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
---

<!-- Scroll-progress bar: purely decorative, sits above nav -->
<div
  class="ctoc-progress"
  role="progressbar"
  aria-hidden="true"
  id="ctoc-progress"
></div>

<!-- Desktop sticky TOC rail -->
<nav class="ctoc-rail" aria-label="On this page" id="ctoc-rail">
  <span class="ctoc-eyebrow">On this page</span>
  <ul class="ctoc-list">
    {sections.map((s) => (
      <li>
        {/* Anchor targets may not exist yet — links are inert until MDX adds explicit IDs. */}
        <a class="ctoc-link" href={`#${s.id}`} data-section={s.id}>
          {s.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<!-- Mobile "Jump to" floating chip -->
<div class="ctoc-mobile" id="ctoc-mobile" aria-hidden="true">
  <button
    class="ctoc-chip"
    id="ctoc-chip-btn"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="ctoc-sheet"
  >
    Jump to ↓
  </button>

  <div
    class="ctoc-sheet"
    id="ctoc-sheet"
    role="dialog"
    aria-modal="true"
    aria-label="Page sections"
    hidden
  >
    <ul class="ctoc-sheet-list">
      {sections.map((s) => (
        <li>
          <a class="ctoc-sheet-link" href={`#${s.id}`} data-section={s.id}>
            {s.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  /* ─── Scroll-progress bar ─── */
  .ctoc-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 100;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    pointer-events: none;
  }

  /* ─── Desktop rail ─── */
  .ctoc-rail {
    display: none; /* hidden on mobile; shown at ≥1100px via media query */
    position: sticky;
    top: 96px;
    width: 220px;
    flex-shrink: 0;
    align-self: flex-start;
  }

  .ctoc-eyebrow {
    display: block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: 12px;
    padding: 0 12px;
  }

  .ctoc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .ctoc-link {
    display: block;
    padding: 8px 12px;
    font-size: 14px;
    color: var(--color-secondary);
    text-decoration: none;
    border-left: 2px solid transparent;
    line-height: 1.45;
    transition: color 0.15s, border-color 0.15s;
  }

  .ctoc-link:hover {
    color: var(--color-primary);
    border-left-color: var(--color-border);
  }

  .ctoc-link.active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    font-weight: 500;
  }

  @media (min-width: 1100px) {
    .ctoc-rail {
      display: flex;
      flex-direction: column;
    }
  }

  /* ─── Mobile floating chip ─── */
  .ctoc-mobile {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    /* hidden until JS reveals it after scrolling past hero */
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s;
  }

  .ctoc-mobile.visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* Hide chip on desktop — desktop uses the rail */
  @media (min-width: 1100px) {
    .ctoc-mobile {
      display: none !important;
    }
  }

  .ctoc-chip {
    background: var(--color-primary);
    color: oklch(1 0 0);
    border: none;
    border-radius: 9999px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 12px oklch(0 0 0 / 0.18);
    transition: background 0.15s, transform 0.15s;
  }

  .ctoc-chip:hover {
    background: var(--color-secondary);
    transform: translateY(-1px);
  }

  /* Bottom-sheet panel */
  .ctoc-sheet {
    position: absolute;
    bottom: calc(100% + 8px);
    right: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow: 0 8px 32px oklch(0 0 0 / 0.12);
    min-width: 200px;
    overflow: hidden;
  }

  .ctoc-sheet[hidden] {
    display: none;
  }

  .ctoc-sheet-list {
    list-style: none;
    padding: 8px 0;
    margin: 0;
  }

  .ctoc-sheet-link {
    display: block;
    padding: 10px 20px;
    font-size: 14px;
    color: var(--color-secondary);
    text-decoration: none;
    transition: background 0.12s, color 0.12s;
  }

  .ctoc-sheet-link:hover {
    background: var(--color-surface-warm);
    color: var(--color-primary);
  }
</style>

<script>
  // ─── Scroll-progress bar ───
  const progressBar = document.getElementById('ctoc-progress') as HTMLElement | null;
  if (progressBar) {
    let rafProgress = 0;
    function updateProgress() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0;
      progressBar!.style.transform = `scaleX(${ratio})`;
      rafProgress = 0;
    }
    window.addEventListener('scroll', () => {
      if (!rafProgress) rafProgress = requestAnimationFrame(updateProgress);
    }, { passive: true });
  }

  // ─── Active-section tracking (desktop rail) ───
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.ctoc-link');
  if (tocLinks.length > 0) {
    const sectionIds = Array.from(tocLinks).map(l => l.dataset.section!);
    const sectionEls = sectionIds
      .map(id => document.getElementById(id))
      .filter(Boolean) as HTMLElement[];

    if (sectionEls.length > 0) {
      const obs = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const id = entry.target.id;
            const link = document.querySelector<HTMLAnchorElement>(`.ctoc-link[data-section="${id}"]`);
            if (link) {
              if (entry.isIntersecting) {
                // Remove active from all, set on current
                tocLinks.forEach(l => l.classList.remove('active'));
                link.classList.add('active');
              }
            }
          }
        },
        { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
      );
      sectionEls.forEach(el => obs.observe(el));
    }
  }

  // ─── Mobile chip: show after scrolling past hero ───
  const mobileChip = document.getElementById('ctoc-mobile') as HTMLElement | null;
  if (mobileChip) {
    // Hero element is the first <header> or element with id="chero"
    const hero = document.getElementById('chero') ?? document.querySelector('header');
    if (hero) {
      const heroObs = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            mobileChip.classList.remove('visible');
            mobileChip.setAttribute('aria-hidden', 'true');
          } else {
            mobileChip.classList.add('visible');
            mobileChip.setAttribute('aria-hidden', 'false');
          }
        },
        { threshold: 0 }
      );
      heroObs.observe(hero);
    } else {
      // Fallback: scrollY > 600
      let rafMobile = 0;
      window.addEventListener('scroll', () => {
        if (!rafMobile) {
          rafMobile = requestAnimationFrame(() => {
            if (window.scrollY > 600) {
              mobileChip.classList.add('visible');
              mobileChip.setAttribute('aria-hidden', 'false');
            } else {
              mobileChip.classList.remove('visible');
              mobileChip.setAttribute('aria-hidden', 'true');
            }
            rafMobile = 0;
          });
        }
      }, { passive: true });
    }
  }

  // ─── Mobile bottom-sheet: open/close + focus trap ───
  const chipBtn = document.getElementById('ctoc-chip-btn') as HTMLButtonElement | null;
  const sheet = document.getElementById('ctoc-sheet') as HTMLElement | null;

  function openSheet() {
    if (!sheet || !chipBtn) return;
    sheet.removeAttribute('hidden');
    chipBtn.setAttribute('aria-expanded', 'true');
    // Move focus to first link
    const firstLink = sheet.querySelector<HTMLElement>('a');
    firstLink?.focus();
  }

  function closeSheet() {
    if (!sheet || !chipBtn) return;
    sheet.setAttribute('hidden', '');
    chipBtn.setAttribute('aria-expanded', 'false');
    chipBtn.focus();
  }

  chipBtn?.addEventListener('click', () => {
    const isOpen = chipBtn.getAttribute('aria-expanded') === 'true';
    if (isOpen) closeSheet(); else openSheet();
  });

  // Close links navigate + close sheet
  sheet?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => closeSheet());
  });

  // Esc closes
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sheet && !sheet.hasAttribute('hidden')) {
      closeSheet();
    }
  });

  // Click-away closes
  document.addEventListener('pointerdown', (e) => {
    if (!sheet || sheet.hasAttribute('hidden')) return;
    const mobileEl = document.getElementById('ctoc-mobile');
    if (mobileEl && !mobileEl.contains(e.target as Node)) {
      closeSheet();
    }
  });

  // Focus trap inside sheet
  sheet?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const focusable = Array.from(sheet.querySelectorAll<HTMLElement>('a, button'));
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>

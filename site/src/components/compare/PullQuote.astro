---
interface Props {
  quote: string;
  attribution?: string;
}
const { quote, attribution } = Astro.props;
---

<figure class="pullquote" data-reveal>
  <svg class="pullquote-mark" viewBox="0 0 32 32" aria-hidden="true">
    <path fill="currentColor" d="M13 10c0-2.2-1.8-4-4-4H8c-2.2 0-4 1.8-4 4v3c0 5 3 8 7 9v-3c-2-.8-3-2.5-3-5V13h1c1.7 0 3-1.3 3-3zm15 0c0-2.2-1.8-4-4-4h-1c-2.2 0-4 1.8-4 4v3c0 5 3 8 7 9v-3c-2-.8-3-2.5-3-5V13h1c1.7 0 3-1.3 3-3z"/>
  </svg>
  <blockquote>{quote}</blockquote>
  {attribution && <figcaption>— {attribution}</figcaption>}
</figure>

<style>
  .pullquote {
    margin: 48px auto;
    max-width: 760px;
    padding: 32px 36px;
    border-left: 3px solid var(--color-accent);
    background: var(--color-surface-warm);
    border-radius: 0 12px 12px 0;
    position: relative;
  }
  .pullquote-mark {
    position: absolute;
    top: 18px;
    right: 24px;
    width: 28px;
    height: 28px;
    color: var(--color-accent);
    opacity: 0.35;
  }
  blockquote {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1.4;
    color: var(--color-primary);
    margin: 0;
    font-style: italic;
  }
  figcaption {
    margin-top: 12px;
    font-size: 14px;
    color: var(--color-muted);
  }
</style>

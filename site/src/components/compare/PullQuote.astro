---
interface Props {
  quote: string;
  attribution?: string;
  source?: string;
}
const { quote, attribution, source } = Astro.props;
---

<figure class="pullquote" data-reveal>
  <div class="pullquote-inner">
    <span class="pullquote-mark" aria-hidden="true">&ldquo;</span>
    <blockquote>{quote}</blockquote>
    {attribution && (
      <figcaption>
        {source ? (
          <a href={source}>{attribution}</a>
        ) : (
          attribution
        )}
      </figcaption>
    )}
  </div>
</figure>

<style>
  /* Full-bleed band — breaks out of the centered article column to span the
     full viewport. Canonical formula: width: 100vw + negative inline margins
     sized so the left/right edges land at the viewport edges. No positioning
     tricks; works because the ancestor .compare-body is centered. */
  .pullquote {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: 80px;
    margin-bottom: 80px;
    padding: clamp(64px, 10vw, 112px) 24px;
    background: var(--color-bg);
    text-align: center;
  }
  .pullquote-inner {
    max-width: 880px;
    margin: 0 auto;
  }
  /* Oversized quote mark as the visual anchor — replaces the old
     left-border accent with a typographic gesture. */
  .pullquote-mark {
    display: block;
    font-size: clamp(72px, 10vw, 112px);
    line-height: 0.6;
    color: var(--color-accent);
    margin-bottom: 16px;
    user-select: none;
    font-weight: 600;
  }
  blockquote {
    font-size: clamp(26px, 3.2vw, 40px);
    line-height: 1.3;
    color: var(--color-primary);
    margin: 0;
    letter-spacing: -0.015em;
    font-weight: 600;
  }
  figcaption {
    margin-top: 24px;
    font-size: 13px;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  figcaption a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  figcaption a:hover {
    color: var(--color-accent);
  }
</style>

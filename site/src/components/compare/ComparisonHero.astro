---
interface CompetitorOption {
  slug: string;
  competitor: string;
  competitorLogo?: string;
}
interface Props {
  title: string;
  shortTitle?: string;
  description: string;
  competitor: string;
  competitorLogo?: string;
  competitorTagline?: string;
  competitorOptions?: CompetitorOption[];
  currentSlug?: string;
}
const {
  title,
  shortTitle,
  description,
  competitor,
  competitorLogo,
  competitorTagline,
  competitorOptions = [],
  currentSlug,
} = Astro.props;
const hasOptions = competitorOptions.length > 0;
---

<header class="chero" id="chero">
  <!-- Atmospheric mesh gradient background -->
  <div class="chero-mesh" aria-hidden="true">
    <div class="chero-blob chero-blob-1"></div>
    <div class="chero-blob chero-blob-2"></div>
    <div class="chero-blob chero-blob-3"></div>
  </div>

  <div class="chero-inner">
    <!-- Eyebrow -->
    <div class="chero-eyebrow-wrap" data-reveal>
      <span class="pill-badge">Compare</span>
    </div>

    <!-- Logo row -->
    <div class="chero-logos" data-reveal data-reveal-delay="1">
      <span class="chero-chip">
        <svg viewBox="0 0 81 82" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="chero-chip-mark">
          <path d="M40.5 0.426758C18.1325 0.426758 0 18.5592 0 40.9268C0 63.2943 18.1325 81.4268 40.5 81.4268C62.8675 81.4268 81 63.2943 81 40.9268C81 18.5592 62.8675 0.426758 40.5 0.426758ZM40.5 11.998C56.4767 11.998 69.4285 24.9501 69.4287 40.9268C69.4287 56.9036 56.4768 69.8555 40.5 69.8555C24.5234 69.8552 11.5723 56.9034 11.5723 40.9268C11.5724 24.9503 24.5235 11.9983 40.5 11.998Z" fill="#F17829"/>
        </svg>
        <span class="chero-chip-name">Kitaru</span>
      </span>

      <span class="chero-vs" aria-label="versus">vs</span>

      {hasOptions ? (
        <div class="chero-chip-dd" data-chero-dd>
          <button
            type="button"
            id="chero-competitor-btn"
            class="chero-chip chero-chip-trigger"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="chero-competitor-menu"
            aria-label={`Switch comparison. Currently ${competitor}.`}
            data-chero-trigger
          >
            {competitorLogo ? (
              <img src={competitorLogo} alt="" class="chero-chip-mark chero-chip-img" />
            ) : (
              <span class="chero-chip-circle" aria-hidden="true">{competitor.charAt(0)}</span>
            )}
            <span class="chero-chip-name">{competitor}</span>
            <svg
              class="chero-chip-chevron"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>

          <ul
            id="chero-competitor-menu"
            class="chero-chip-menu"
            role="menu"
            aria-labelledby="chero-competitor-btn"
            hidden
            data-chero-menu
          >
            {competitorOptions.map((opt) => (
              <li role="none">
                <a
                  href={`/compare/${opt.slug}/`}
                  role="menuitem"
                  class="chero-chip-menu-item"
                  aria-current={opt.slug === currentSlug ? 'page' : undefined}
                >
                  {opt.competitorLogo ? (
                    <img src={opt.competitorLogo} alt="" class="chero-chip-menu-logo" />
                  ) : (
                    <span class="chero-chip-menu-avatar" aria-hidden="true">{opt.competitor.charAt(0)}</span>
                  )}
                  <span class="chero-chip-menu-name">{opt.competitor}</span>
                  <svg
                    class="chero-chip-menu-caret"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="9 6 15 12 9 18" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <span class="chero-chip">
          {competitorLogo ? (
            <img src={competitorLogo} alt={`${competitor} logo`} class="chero-chip-mark chero-chip-img" />
          ) : (
            <span class="chero-chip-circle" aria-hidden="true">{competitor.charAt(0)}</span>
          )}
          <span class="chero-chip-name">{competitor}</span>
        </span>
      )}
    </div>

    <!-- Optional competitor tagline -->
    {competitorTagline && (
      <p class="chero-tagline" data-reveal data-reveal-delay="2">{competitorTagline}</p>
    )}

    <!-- Hero title -->
    <h1 class="chero-title" data-reveal data-reveal-delay={competitorTagline ? "3" : "2"}>{shortTitle ?? title}</h1>

    <!-- Description -->
    <p class="chero-desc" data-reveal data-reveal-delay={competitorTagline ? "4" : "3"}>{description}</p>

    <!-- CTA row: install chip + primary + secondary -->
    <div class="chero-ctas" data-reveal data-reveal-delay={competitorTagline ? "5" : "4"}>
      <!-- Visually-hidden live region announces copy success to screen readers -->
      <span class="sr-only" id="chero-copy-status" aria-live="polite" aria-atomic="true"></span>
      <div class="chero-install">
        <code class="chero-install-cmd">pip install kitaru</code>
        <button
          class="chero-copy-btn"
          aria-label="Copy install command"
          data-copy="pip install kitaru"
        >
          <svg class="chero-copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2"/>
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
          </svg>
          <svg class="chero-check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </button>
      </div>
      <a href="/book-a-demo/" class="btn-primary">Book a demo</a>
      <a href="/docs/" class="btn-secondary">Read the docs</a>
    </div>
  </div>
</header>

<style>
  /* ─── Hero shell ─── */
  .chero {
    position: relative;
    padding: 120px 24px 64px;
    text-align: center;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border-light);
  }

  /* ─── Mesh gradient atmosphere ─── */
  /* decorative mesh gradient — accent alpha on warm bg */
  .chero-mesh {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  .chero-blob {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  /* top-left warm blob */
  .chero-blob-1 {
    width: 900px;
    height: 900px;
    top: -30%;
    left: -20%;
    /* decorative mesh gradient */
    background: var(--mesh-accent-strong);
    filter: blur(40px);
    animation: cheroFloat1 11s ease-in-out infinite alternate;
  }

  /* right-middle amber blob */
  .chero-blob-2 {
    width: 800px;
    height: 800px;
    top: 10%;
    right: -20%;
    /* decorative mesh gradient */
    background: var(--mesh-warm);
    filter: blur(50px);
    animation: cheroFloat2 14s ease-in-out infinite alternate;
  }

  /* bottom-center soft glow */
  .chero-blob-3 {
    width: 700px;
    height: 700px;
    bottom: -20%;
    left: 25%;
    /* decorative mesh gradient */
    background: var(--mesh-accent-soft);
    filter: blur(40px);
    animation: cheroFloat3 9s ease-in-out infinite alternate;
  }

  @keyframes cheroFloat1 {
    0%   { transform: translate(0, 0) scale(1); }
    50%  { transform: translate(12%, 15%) scale(1.1); }
    100% { transform: translate(-6%, 8%) scale(0.95); }
  }

  @keyframes cheroFloat2 {
    0%   { transform: translate(0, 0) scale(1); }
    50%  { transform: translate(-10%, 12%) scale(1.12); }
    100% { transform: translate(6%, -8%) scale(0.9); }
  }

  @keyframes cheroFloat3 {
    0%   { transform: translate(0, 0) scale(1); }
    50%  { transform: translate(-15%, -10%) scale(1.15); }
    100% { transform: translate(10%, 6%) scale(0.92); }
  }

  /* ─── Inner content ─── */
  .chero-inner {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ─── Eyebrow ─── */
  .chero-eyebrow-wrap {
    margin-bottom: 28px;
  }
  /* Scoped override of the shared .pill-badge inside the compare hero:
     no background/border, primary color, all caps, JetBrains Mono. */
  .chero-eyebrow-wrap .pill-badge {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ─── Logo row ─── */
  /* Positioned + elevated so the competitor dropdown menu stacks above the
     later-painted .chero-title, which data-reveal promotes to its own
     stacking context via transform. */
  .chero-logos {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .chero-chip {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 20px;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-surface);
    font-size: 20px;
    font-weight: 600;
    color: var(--color-primary);
  }

  /* ─── Competitor chip as a dropdown trigger ─── */
  /* The trigger inherits the static .chero-chip look exactly. We only add:
     - cursor + button reset
     - chevron icon with rotation on open
     - subtle hover/focus state to hint interactivity */
  .chero-chip-dd {
    position: relative;
    display: inline-block;
  }

  button.chero-chip-trigger {
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  }

  .chero-chip-trigger:hover {
    border-color: oklch(0.65 0.16 45 / 0.4);
  }

  .chero-chip-trigger:focus-visible {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring-accent);
  }

  .chero-chip-chevron {
    margin-left: 2px;
    color: var(--color-muted);
    transition: transform 0.2s ease, color 0.2s;
    flex-shrink: 0;
  }

  .chero-chip-trigger[aria-expanded="true"] .chero-chip-chevron {
    transform: rotate(180deg);
    color: var(--color-accent);
  }

  /* ─── Dropdown menu ─── */
  .chero-chip-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 240px;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    box-shadow: 0 20px 40px -16px oklch(0 0 0 / 0.18), 0 2px 6px -2px oklch(0 0 0 / 0.08);
    z-index: 20;
    text-align: left;
    animation: cheroMenuIn 0.14s ease-out;
  }

  .chero-chip-menu[hidden] {
    display: none;
  }

  @keyframes cheroMenuIn {
    from { opacity: 0; transform: translate(-50%, -4px); }
    to   { opacity: 1; transform: translate(-50%, 0); }
  }

  .chero-chip-menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-primary);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .chero-chip-menu-item:hover,
  .chero-chip-menu-item:focus-visible {
    background: var(--color-surface-warm);
    outline: none;
  }

  .chero-chip-menu-item[aria-current="page"] {
    color: var(--color-accent);
  }

  .chero-chip-menu-logo {
    width: 20px;
    height: 20px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .chero-chip-menu-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-accent-darker);
    color: oklch(1 0 0);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .chero-chip-menu-name {
    flex: 1;
    white-space: nowrap;
  }

  .chero-chip-menu-caret {
    color: var(--color-muted);
    flex-shrink: 0;
    transition: transform 0.15s, color 0.15s;
  }

  .chero-chip-menu-item:hover .chero-chip-menu-caret,
  .chero-chip-menu-item:focus-visible .chero-chip-menu-caret {
    transform: translateX(2px);
    color: var(--color-accent);
  }

  .chero-chip-mark {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }

  .chero-chip-img {
    object-fit: contain;
  }

  /* Filled accent circle fallback for competitor logo */
  .chero-chip-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-accent-darker);
    color: oklch(1 0 0);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .chero-chip-name {
    /* inherits chip font-size + weight */
  }

  /* Lowercase "vs" separator between the logo chips */
  .chero-vs {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    user-select: none;
  }

  /* ─── Competitor tagline (optional) ─── */
  .chero-tagline {
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-muted);
    font-style: italic;
    max-width: 520px;
    margin: 0 0 20px;
  }

  /* ─── Title ─── */
  .chero-title {
    font-size: clamp(32px, 4.4vw, 56px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-primary);
    margin: 0 0 20px;
  }

  /* ─── Description ─── */
  .chero-desc {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-secondary);
    max-width: 680px;
    margin: 0 0 32px;
  }

  /* ─── CTA row ─── */
  .chero-ctas {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Install chip */
  .chero-install {
    display: inline-flex;
    align-items: center;
    gap: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 4px 4px 4px 20px;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .chero-install:hover {
    border-color: oklch(0.65 0.16 45 / 0.3);
    box-shadow: var(--focus-ring-accent);
  }

  .chero-install-cmd {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-primary);
    user-select: all;
    letter-spacing: -0.01em;
  }

  .chero-copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    color: var(--color-muted);
    border-radius: 6px;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
    margin-left: 8px;
    flex-shrink: 0;
  }

  .chero-copy-btn:hover {
    color: var(--color-primary);
    background: oklch(0 0 0 / 0.04);
  }

  .chero-copy-btn .chero-copy-icon,
  .chero-copy-btn .chero-check-icon {
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.15s;
  }

  .chero-copy-btn .chero-check-icon {
    display: none;
    color: var(--color-success);
  }

  .chero-copy-btn.copied .chero-copy-icon {
    display: none;
  }

  .chero-copy-btn.copied .chero-check-icon {
    display: block;
    animation: chero-check-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes chero-check-pop {
    0%   { transform: scale(0); opacity: 0; }
    60%  { transform: scale(1.2); }
    100% { transform: scale(1); opacity: 1; }
  }

  /* ─── Responsive ─── */
  @media (max-width: 640px) {
    .chero {
      padding: 80px 20px 48px;
    }

    /* Stack logos vertically so "vs" gets its own line instead of orphaning at line-end */
    .chero-logos {
      flex-direction: column;
      gap: 14px;
    }

    .chero-vs {
      margin: 0;
    }

    .chero-chip {
      font-size: 16px;
      padding: 8px 14px;
    }

    .chero-ctas {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }

    .chero-ctas .btn-primary,
    .chero-ctas .btn-secondary {
      width: 100%;
      justify-content: center;
      text-align: center;
    }

    .chero-blob-1 { width: 420px; height: 420px; }
    .chero-blob-2 { width: 350px; height: 350px; }
    .chero-blob-3 { width: 280px; height: 280px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chero-blob {
      animation: none;
    }
  }
</style>

<script>
  // ─── Copy-to-clipboard for ComparisonHero install chip ───
  import { copyToClipboard } from '../../scripts/clipboard';

  // ─── Competitor dropdown ───
  const ddRoot = document.querySelector<HTMLElement>('#chero [data-chero-dd]');
  const ddTrigger = ddRoot?.querySelector<HTMLButtonElement>('[data-chero-trigger]');
  const ddMenu = ddRoot?.querySelector<HTMLElement>('[data-chero-menu]');

  function openMenu() {
    if (!ddTrigger || !ddMenu) return;
    ddMenu.removeAttribute('hidden');
    ddTrigger.setAttribute('aria-expanded', 'true');
  }

  function closeMenu(restoreFocus = false) {
    if (!ddTrigger || !ddMenu) return;
    ddMenu.setAttribute('hidden', '');
    ddTrigger.setAttribute('aria-expanded', 'false');
    if (restoreFocus) ddTrigger.focus();
  }

  ddTrigger?.addEventListener('click', () => {
    const open = ddTrigger.getAttribute('aria-expanded') === 'true';
    if (open) closeMenu(); else openMenu();
  });

  // Keyboard: ArrowDown on trigger opens + focuses first item
  ddTrigger?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
      const open = ddTrigger.getAttribute('aria-expanded') === 'true';
      if (!open) {
        e.preventDefault();
        openMenu();
        ddMenu?.querySelector<HTMLElement>('a[role="menuitem"]')?.focus();
      }
    }
  });

  // Arrow key navigation within the menu
  ddMenu?.addEventListener('keydown', (e) => {
    const items = Array.from(ddMenu.querySelectorAll<HTMLElement>('a[role="menuitem"]'));
    if (items.length === 0) return;
    const idx = items.indexOf(document.activeElement as HTMLElement);
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      items[(idx + 1) % items.length].focus();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      items[(idx - 1 + items.length) % items.length].focus();
    } else if (e.key === 'Home') {
      e.preventDefault();
      items[0].focus();
    } else if (e.key === 'End') {
      e.preventDefault();
      items[items.length - 1].focus();
    }
  });

  // Esc closes and restores focus
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && ddTrigger?.getAttribute('aria-expanded') === 'true') {
      closeMenu(true);
    }
  });

  // Click outside closes
  document.addEventListener('pointerdown', (e) => {
    if (!ddRoot || ddTrigger?.getAttribute('aria-expanded') !== 'true') return;
    if (!ddRoot.contains(e.target as Node)) closeMenu();
  });

  // ─── Copy-to-clipboard ───
  document.querySelectorAll<HTMLButtonElement>('#chero .chero-copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = btn.dataset.copy ?? '';
      copyToClipboard(text).then(() => {
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 1500);
        // Announce to screen readers via the live region
        const status = document.getElementById('chero-copy-status');
        if (status) {
          status.textContent = 'Install command copied to clipboard';
          setTimeout(() => { status.textContent = ''; }, 1500);
        }
      }).catch(() => {
        btn.setAttribute('aria-label', 'Copy failed');
        setTimeout(() => btn.setAttribute('aria-label', 'Copy install command'), 2000);
      });
    });
  });
</script>

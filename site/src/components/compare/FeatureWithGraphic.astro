---
/**
 * FeatureWithGraphic — alternating feature row.
 *
 * Default: two-column layout pairing prose (slot) with a graphic image. Pass
 * `reverse` to flip the layout so the graphic appears on the left. Collapses
 * to a single column on narrow viewports with the graphic always below the title.
 *
 * List variant: when a `bullets` slot is passed (typically a markdown list),
 * the section stacks vertically — intro prose, then a larger centered graphic,
 * then a 2-column bullet grid with accent-colored labels. Use this for
 * sections whose body is dominated by a bulleted list of bold-labeled items.
 */
interface Props {
  title: string;
  image?: string;
  imageAlt?: string;
  reverse?: boolean;
  headingLevel?: 2 | 3;
  number?: string;
  bgStrip?: boolean;
  layout?: "default" | "list";
}

const { title, image, imageAlt, reverse = false, headingLevel = 2, number, bgStrip = false, layout = "default" } = Astro.props;
const hasGraphicSlot = Astro.slots.has('graphic');
const hasBulletsSlot = Astro.slots.has('bullets');
const isList = layout === "list" || hasBulletsSlot;
---

<section class:list={["feature-graphic", { "feature-graphic--reverse": reverse && !isList, "feature-graphic--bg-strip": bgStrip, "feature-graphic--list": isList }]} data-reveal>
  <div class="feature-graphic-grid">
    <div class="feature-graphic-copy">
      {number && <span class="feature-graphic-eyebrow">{number}</span>}
      {headingLevel === 3 ? <h3>{title}</h3> : <h2>{title}</h2>}
      <div class="feature-graphic-body">
        <slot />
      </div>
    </div>
    <div class="feature-graphic-media">
      {hasGraphicSlot ? (
        <slot name="graphic" />
      ) : image ? (
        <img src={image} alt={imageAlt ?? ''} loading="lazy" decoding="async" />
      ) : null}
    </div>
    {isList && (
      <div class="feature-graphic-bullets">
        <slot name="bullets" />
      </div>
    )}
  </div>
</section>

<style>
  /* Default: fill the article column. The viewport-centered break-out used to
     escape the 820px prose cap, but at ≥1100px the TOC rail occupies the
     left gutter — a viewport break-out would overlap the rail. Stay in-column
     at desktop; break out only below the grid breakpoint. */
  .feature-graphic {
    margin: 56px 0;
    width: 100%;
  }
  .feature-graphic--bg-strip {
    background: var(--color-surface-warm);
    border-radius: 24px;
    padding: 56px 48px;
  }
  .feature-graphic-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 56px;
    align-items: center;
  }
  /* Reverse layout: flip both the column widths and the visual order so the
     graphic still lands in the wider column on the opposite side. */
  .feature-graphic--reverse .feature-graphic-grid {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
  }
  .feature-graphic--reverse .feature-graphic-copy { order: 2; }
  .feature-graphic--reverse .feature-graphic-media { order: 1; }

  .feature-graphic-eyebrow {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 12px;
  }
  .feature-graphic-copy h2,
  .feature-graphic-copy h3 {
    font-size: clamp(24px, 2.6vw, 30px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0 0 14px;
    color: var(--color-primary);
  }
  .feature-graphic-body :global(p) {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-secondary);
    margin: 0 0 14px;
  }
  .feature-graphic-body :global(p:last-child) { margin-bottom: 0; }

  .feature-graphic-media {
    display: flex;
    justify-content: center;
  }
  .feature-graphic-media img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* List variant: stacked layout with a larger centered graphic between the
     intro prose and a 2-column bullet grid. */
  .feature-graphic--list .feature-graphic-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: stretch;
  }
  .feature-graphic--list .feature-graphic-media {
    background: var(--color-bg);
    border-radius: 8px;
    padding: 60px;
    width: 100%;
    margin: 4px 0 0;
    box-sizing: border-box;
  }
  .feature-graphic--list .feature-graphic-media img {
    max-width: 100%;
    margin: 0 auto;
  }
  /* Inner graphic content stays centered and readable inside the wider box. */
  .feature-graphic--list .feature-graphic-media > :global(*) {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }
  .feature-graphic--list .feature-graphic-body :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Break out of the 820px prose cap applied by .compare-body-inner :global(ul)
     so the bullet grid can fill the full 1192px content column. */
  .feature-graphic-bullets :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 48px;
    row-gap: 24px;
  }
  /* Column count by bullet count: 2/4 → 2 cols (default); 3, 5, 6+ → 3 cols. */
  .feature-graphic-bullets :global(ul:has(> li:nth-child(3):last-child)),
  .feature-graphic-bullets :global(ul:has(> li:nth-child(5):last-child)),
  .feature-graphic-bullets :global(ul:has(> li:nth-child(6))) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 36px;
  }
  .feature-graphic-bullets :global(li) {
    position: relative;
    padding-left: 26px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-secondary);
  }
  .feature-graphic-bullets :global(li)::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 9px;
    width: 9px;
    height: 9px;
    background: var(--color-accent);
    transform: rotate(45deg);
    border-radius: 1px;
  }
  .feature-graphic-bullets :global(li strong) {
    color: var(--color-accent-darker);
    font-weight: 700;
  }

  @media (max-width: 820px) {
    .feature-graphic { margin: 40px 0; }
    .feature-graphic--bg-strip {
      margin-left: -24px;
      margin-right: -24px;
      padding: 32px 24px;
      border-radius: 16px;
      width: calc(100% + 48px);
      left: calc(50% - 24px);
    }
    /* Include the higher-specificity reverse selector so both layouts collapse. */
    .feature-graphic-grid,
    .feature-graphic--reverse .feature-graphic-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .feature-graphic--reverse .feature-graphic-copy,
    .feature-graphic--reverse .feature-graphic-media {
      order: initial;
    }
    .feature-graphic-media img { max-width: 420px; }
    .feature-graphic--list .feature-graphic-media {
      padding: 28px 20px;
    }
    .feature-graphic--list .feature-graphic-media img { max-width: 100%; }

    .feature-graphic-bullets :global(ul) {
      grid-template-columns: 1fr;
      row-gap: 18px;
    }
    /* Collapse 3-col to 1-col on mobile (overrides the :has() 3-col rules). */
    .feature-graphic-bullets :global(ul:has(> li:nth-child(3):last-child)),
    .feature-graphic-bullets :global(ul:has(> li:nth-child(5):last-child)),
    .feature-graphic-bullets :global(ul:has(> li:nth-child(6))) {
      grid-template-columns: 1fr;
    }
  }
</style>

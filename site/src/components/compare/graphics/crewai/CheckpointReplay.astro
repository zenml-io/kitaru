---
---

<figure class="fig">
  <div class="row row--competitor">
    <div class="row-head">
      <span class="tag tag--muted">CrewAI Flow</span>
      <span class="row-sub">Stateful Flow, replay starts from the top</span>
    </div>
    <div class="timeline">
      <div class="step step--rerun">
        <span class="step-key">step 1</span>
        <span class="step-val">research()</span>
        <span class="step-cost">LLM</span>
      </div>
      <span class="conn">→</span>
      <div class="step step--rerun">
        <span class="step-key">step 2</span>
        <span class="step-val">plan()</span>
        <span class="step-cost">LLM</span>
      </div>
      <span class="conn">→</span>
      <div class="step step--rerun">
        <span class="step-key">step 3</span>
        <span class="step-val">draft()</span>
        <span class="step-cost">LLM</span>
      </div>
      <span class="conn">→</span>
      <div class="step step--fail">
        <span class="step-key">step 4</span>
        <span class="step-val">critique()</span>
        <span class="step-cost step-cost--fail">crash</span>
      </div>
    </div>
    <div class="row-foot">
      <span class="rerun-tag">Re-run</span>
      <span>All 4 LLM calls billed again on the next run.</span>
    </div>
  </div>

  <div class="row row--kitaru">
    <div class="row-head">
      <span class="tag tag--accent">Kitaru · @checkpoint</span>
      <span class="row-sub">Replay reuses cached outputs above the failure</span>
    </div>
    <div class="timeline">
      <div class="step step--cached">
        <span class="step-key">step 1</span>
        <span class="step-val">research()</span>
        <span class="step-cost step-cost--cached">cached</span>
      </div>
      <span class="conn conn--accent">→</span>
      <div class="step step--cached">
        <span class="step-key">step 2</span>
        <span class="step-val">plan()</span>
        <span class="step-cost step-cost--cached">cached</span>
      </div>
      <span class="conn conn--accent">→</span>
      <div class="step step--cached">
        <span class="step-key">step 3</span>
        <span class="step-val">draft()</span>
        <span class="step-cost step-cost--cached">cached</span>
      </div>
      <span class="conn conn--accent">→</span>
      <div class="step step--replay">
        <span class="step-key">step 4</span>
        <span class="step-val">critique()</span>
        <span class="step-cost step-cost--replay">re-runs</span>
      </div>
    </div>
    <div class="row-foot row-foot--accent">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 12 A9 9 0 1 0 6 5 L3 8 M3 3 L3 8 L8 8" />
      </svg>
      <span><code>kitaru executions replay &lt;exec_id&gt; --from step_4</code> reads steps 1-3 from the artifact store.</span>
    </div>
  </div>
</figure>

<style>
  .fig {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 0;
  }
  .row {
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .row--competitor {
    background: var(--color-surface-warm);
    border-style: dashed;
  }
  .row--kitaru {
    border-color: var(--color-accent);
  }
  .row-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .row-sub {
    font-size: 11.5px;
    color: var(--color-secondary);
  }
  .tag {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 4px;
  }
  .tag--muted {
    background: var(--color-border-light);
    color: var(--color-muted);
  }
  .tag--accent {
    background: var(--color-accent-light);
    color: var(--color-accent-deep);
  }

  .timeline {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 6px;
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 10px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    min-width: 0;
  }
  .step--rerun {
    background: var(--color-bg);
  }
  .step--fail {
    border-color: var(--color-cost-up);
    background: var(--color-cost-up-bg);
  }
  .step--cached {
    border-color: var(--color-border-light);
    background: var(--color-surface-warm);
  }
  .step--replay {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
  }
  .step-key {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .step-val {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-primary);
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .step-cost {
    display: inline-block;
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .step-cost--fail { color: var(--color-cost-up); font-weight: 700; }
  .step-cost--cached { color: var(--color-secondary); }
  .step-cost--replay { color: var(--color-accent); font-weight: 700; }

  .conn {
    font-size: 14px;
    color: var(--color-muted);
    font-weight: 700;
    text-align: center;
  }
  .conn--accent {
    color: var(--color-accent);
  }

  .row-foot {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--color-border-light);
    font-size: 11.5px;
    color: var(--color-secondary);
  }
  .row-foot--accent {
    color: var(--color-primary);
  }
  .row-foot svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }
  .row-foot code {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-primary);
    background: var(--color-surface);
    padding: 1px 5px;
    border: 1px solid var(--color-border-light);
    border-radius: 3px;
  }
  .rerun-tag {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-cost-up);
    padding: 2px 7px;
    background: var(--color-cost-up-bg);
    border-radius: 4px;
  }

  @media (max-width: 560px) {
    .timeline {
      grid-template-columns: 1fr;
    }
    .conn { display: none; }
  }
</style>

---
---

<figure class="fig">
  <div class="lane lane--competitor">
    <div class="lane-head">
      <span class="lane-label">OpenAI Agents SDK approval</span>
      <span class="lane-sub">Worker stays alive while it waits</span>
    </div>
    <div class="timeline">
      <div class="tick">
        <span class="tick-dot"></span>
        <span class="tick-text">tool approval pause</span>
      </div>
      <div class="bar bar--busy">
        <span class="bar-text">process alive · 6h idle</span>
      </div>
      <div class="tick">
        <span class="tick-dot tick-dot--done"></span>
        <span class="tick-text">human approves</span>
      </div>
    </div>
    <div class="meter">
      <span class="meter-key">Compute</span>
      <span class="meter-bar"><span class="meter-fill meter-fill--full"></span></span>
      <span class="meter-val meter-val--bad">100%</span>
    </div>
  </div>

  <div class="lane lane--kitaru">
    <div class="lane-head">
      <span class="lane-label lane-label--accent">kitaru.wait()</span>
      <span class="lane-sub">Compute released, flow resumes on signal</span>
    </div>
    <div class="timeline">
      <div class="tick">
        <span class="tick-dot tick-dot--accent"></span>
        <span class="tick-text"><code>wait(name="approve")</code></span>
      </div>
      <div class="bar bar--idle">
        <span class="bar-text">no container · 6h waiting</span>
      </div>
      <div class="tick">
        <span class="tick-dot tick-dot--accent"></span>
        <span class="tick-text">signal arrives, flow resumes</span>
      </div>
    </div>
    <div class="meter">
      <span class="meter-key">Compute</span>
      <span class="meter-bar"><span class="meter-fill meter-fill--zero"></span></span>
      <span class="meter-val meter-val--ok">0%</span>
    </div>
  </div>
</figure>

<style>
  .fig {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 0;
    padding: 0;
  }
  .lane {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 16px 16px 18px;
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
  }
  .lane--competitor { background: var(--color-surface-warm); }
  .lane--kitaru { border-color: var(--color-accent); }

  .lane-head { margin-bottom: 14px; }
  .lane-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 4px;
  }
  .lane-label--accent { color: var(--color-accent); }
  .lane-sub {
    display: block;
    font-size: 12px;
    color: var(--color-secondary);
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 4px 0 14px;
  }
  .tick {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 0;
  }
  .tick-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border);
    border: 2px solid var(--color-border);
    flex-shrink: 0;
  }
  .tick-dot--accent {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  .tick-dot--done {
    background: var(--color-muted);
    border-color: var(--color-muted);
  }
  .tick-text {
    font-size: 11.5px;
    color: var(--color-primary);
    font-weight: 500;
  }
  .tick-text code {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-accent-deep);
    background: var(--color-accent-light);
    padding: 1px 5px;
    border-radius: 3px;
  }

  .bar {
    margin-left: 4px;
    border-left: 2px dashed var(--color-border);
    padding: 8px 0 8px 16px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-muted);
    font-style: italic;
  }
  .bar--busy {
    border-left-style: solid;
    border-left-color: var(--color-cost-up);
    background: linear-gradient(to right, var(--color-cost-up-bg) 0%, transparent 70%);
  }
  .bar--idle {
    border-left-style: dashed;
    border-left-color: var(--color-accent);
  }
  .bar-text {
    display: inline-block;
    padding: 2px 7px;
    border-radius: 3px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
  }
  .bar--busy .bar-text {
    color: var(--color-cost-up);
    border-color: var(--color-cost-up);
  }
  .bar--idle .bar-text {
    color: var(--color-accent-deep);
    border-color: var(--color-accent);
  }

  .meter {
    margin-top: auto;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 8px;
    padding-top: 10px;
    border-top: 1px solid var(--color-border-light);
  }
  .meter-key {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .meter-bar {
    display: block;
    height: 6px;
    background: var(--color-bg);
    border-radius: 3px;
    overflow: hidden;
  }
  .meter-fill {
    display: block;
    height: 100%;
    border-radius: 3px;
  }
  .meter-fill--full {
    width: 100%;
    background: var(--color-cost-up);
  }
  .meter-fill--zero {
    width: 4%;
    background: var(--color-accent);
  }
  .meter-val {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
  }
  .meter-val--bad { color: var(--color-cost-up); }
  .meter-val--ok { color: var(--color-accent-deep); }

  @media (max-width: 520px) {
    .fig { grid-template-columns: 1fr; }
  }
</style>

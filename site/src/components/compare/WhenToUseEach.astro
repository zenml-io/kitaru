---
interface Side {
  title: string;
  items: string[];
}
interface Props {
  kitaru: Side;
  competitor: Side;
  competitorLabel?: string;
}
const { kitaru, competitor, competitorLabel = 'Alternative' } = Astro.props;
---

<section class="when" data-reveal>
  <div class="when-grid">
    <article class="when-card when-card--kitaru">
      <div class="when-card-head">
        <span class="when-tag when-tag--kitaru">Kitaru</span>
        <h2>{kitaru.title}</h2>
      </div>
      <ul>
        {kitaru.items.map((item) => (
          <li>
            <svg class="check" viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M7.5 13.5 4 10l-1.5 1.5L7.5 16.5 17.5 6.5 16 5z"/></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </article>

    <article class="when-card when-card--competitor">
      <div class="when-card-head">
        <span class="when-tag when-tag--competitor">{competitorLabel}</span>
        <h2>{competitor.title}</h2>
      </div>
      <ul>
        {competitor.items.map((item) => (
          <li>
            <svg class="check" viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M7.5 13.5 4 10l-1.5 1.5L7.5 16.5 17.5 6.5 16 5z"/></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </article>
  </div>
</section>

<style>
  .when { margin: 56px 0 32px; }
  .when-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  /* Both cards share identical surface treatment — differentiation comes from the
     pill tag color only, so readers perceive the comparison as even-handed.
     Warm cream bg (--color-bg) pops against the near-white page. */
  .when-card {
    background: var(--color-bg);
    border: none;
    border-radius: 8px;
    padding: 32px;
  }
  .when-card-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 16px;
  }
  .when-tag {
    display: inline-flex;
    align-self: flex-start;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .when-tag--kitaru {
    background: var(--color-accent-darker);
    color: oklch(1 0 0);
  }
  .when-tag--competitor {
    background: var(--color-accent-light);
    color: var(--color-secondary);
  }
  .when-card h2 {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-primary);
    margin: 0;
  }
  .when-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .when-card li {
    display: flex;
    gap: 10px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-secondary);
  }
  .check {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 2px;
  }
  /* Checks share the same quiet color on both cards; the pill tags carry the
     Kitaru vs competitor signal, not the bullet ornament. */
  .when-card .check { color: var(--color-secondary); }
  .when-card--kitaru .check { color: var(--color-accent); }

  @media (max-width: 820px) {
    .when-grid { grid-template-columns: 1fr; }
  }
</style>

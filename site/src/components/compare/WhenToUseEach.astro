---
interface Side {
  title: string;
  items: string[];
}
interface Props {
  kitaru: Side;
  competitor: Side;
}
const { kitaru, competitor } = Astro.props;
---

<section class="when" data-reveal>
  <div class="when-grid">
    <article class="when-card when-card--kitaru">
      <div class="when-card-head">
        <span class="when-tag when-tag--kitaru">Kitaru</span>
        <h3>{kitaru.title}</h3>
      </div>
      <ul>
        {kitaru.items.map((item) => (
          <li>
            <svg class="check" viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M7.5 13.5 4 10l-1.5 1.5L7.5 16.5 17.5 6.5 16 5z"/></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </article>

    <article class="when-card when-card--competitor">
      <div class="when-card-head">
        <span class="when-tag when-tag--competitor">Alternative</span>
        <h3>{competitor.title}</h3>
      </div>
      <ul>
        {competitor.items.map((item) => (
          <li>
            <svg class="check" viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M7.5 13.5 4 10l-1.5 1.5L7.5 16.5 17.5 6.5 16 5z"/></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </article>
  </div>
</section>

<style>
  .when { margin: 56px 0 32px; }
  .when-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .when-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 28px;
  }
  .when-card--kitaru {
    background: linear-gradient(180deg, oklch(0.98 0.015 65) 0%, var(--color-surface) 100%);
    border-color: oklch(0.85 0.08 60);
  }
  .when-card-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 16px;
  }
  .when-tag {
    display: inline-flex;
    align-self: flex-start;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .when-tag--kitaru {
    background: var(--color-accent);
    color: oklch(1 0 0);
  }
  .when-tag--competitor {
    background: var(--color-accent-light);
    color: var(--color-secondary);
  }
  .when-card h3 {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-primary);
    margin: 0;
  }
  .when-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .when-card li {
    display: flex;
    gap: 10px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-secondary);
  }
  .check {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 2px;
  }
  .when-card--kitaru .check { color: var(--color-accent); }
  .when-card--competitor .check { color: var(--color-muted); }

  @media (max-width: 820px) {
    .when-grid { grid-template-columns: 1fr; }
  }
</style>

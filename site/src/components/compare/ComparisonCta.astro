---
interface Props {
  headline: string;
  subhead?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  showInstall?: boolean;
}

const {
  headline,
  subhead,
  primaryCtaText = 'Get started',
  primaryCtaHref = '/get-started',
  secondaryCtaText = 'Read the docs',
  secondaryCtaHref = '/docs',
  showInstall = true,
} = Astro.props;
---

<section class="ccta-section" id="cta">
  <!-- decorative mesh gradient — accent alphas on dark bg -->
  <div class="ccta-mesh" aria-hidden="true">
    <div class="ccta-blob ccta-blob-1"></div>
    <div class="ccta-blob ccta-blob-2"></div>
    <div class="ccta-blob ccta-blob-3"></div>
  </div>

  <div class="ccta-inner" data-reveal>
    <h2 class="ccta-headline">{headline}</h2>

    {subhead && (
      <p class="ccta-subhead">{subhead}</p>
    )}

    {showInstall && (
      <div class="ccta-install">
        <code class="ccta-install-cmd">pip install kitaru</code>
        <button
          class="ccta-copy-btn"
          aria-label="Copy install command"
          data-copy="pip install kitaru"
        >
          <svg class="ccta-copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2"/>
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
          </svg>
          <svg class="ccta-check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </button>
      </div>
    )}

    <div class="ccta-actions">
      <a href={primaryCtaHref} class="btn-accent">{primaryCtaText}</a>
      <a href={secondaryCtaHref} class="btn-secondary-dark">{secondaryCtaText}</a>
    </div>
  </div>
</section>

<style>
  /* ─── Section shell ─── */
  .ccta-section {
    padding: 100px 24px;
    text-align: center;
    position: relative;
    overflow: hidden;
    background: var(--color-primary);
  }

  /* ─── Mesh gradient ─── */
  /* decorative mesh gradient — accent alpha blobs on dark surface */
  .ccta-mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .ccta-blob {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  .ccta-blob-1 {
    width: 900px;
    height: 900px;
    top: -30%;
    left: -5%;
    /* decorative mesh gradient */
    background: var(--mesh-accent-strong);
    animation: cctaMesh1 10s ease-in-out infinite alternate;
  }

  .ccta-blob-2 {
    width: 850px;
    height: 850px;
    bottom: -35%;
    right: -5%;
    /* decorative mesh gradient */
    background: var(--mesh-warm);
    animation: cctaMesh2 14s ease-in-out infinite alternate;
  }

  .ccta-blob-3 {
    width: 750px;
    height: 750px;
    top: 10%;
    right: 20%;
    /* decorative mesh gradient */
    background: var(--mesh-accent-soft);
    animation: cctaMesh3 8s ease-in-out infinite alternate;
  }

  @keyframes cctaMesh1 {
    0%   { transform: translate(0, 0) scale(1); }
    25%  { transform: translate(20%, 15%) scale(1.2); }
    50%  { transform: translate(-8%, 28%) scale(0.88); }
    75%  { transform: translate(15%, -10%) scale(1.15); }
    100% { transform: translate(-6%, 12%) scale(1.04); }
  }

  @keyframes cctaMesh2 {
    0%   { transform: translate(0, 0) scale(1); }
    25%  { transform: translate(-18%, -12%) scale(1.16); }
    50%  { transform: translate(12%, -22%) scale(0.84); }
    75%  { transform: translate(-10%, 8%) scale(1.1); }
    100% { transform: translate(8%, -6%) scale(0.94); }
  }

  @keyframes cctaMesh3 {
    0%   { transform: translate(0, 0) scale(1); }
    33%  { transform: translate(-28%, 20%) scale(1.28); }
    66%  { transform: translate(20%, -16%) scale(0.82); }
    100% { transform: translate(-10%, 6%) scale(1.12); }
  }

  /* Radial vignette — darkens center so content pops */
  .ccta-section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(ellipse 70% 80% at 50% 50%, var(--color-primary) 0%, transparent 100%);
    pointer-events: none;
  }

  /* ─── Inner content ─── */
  .ccta-inner {
    position: relative;
    z-index: 10;
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ccta-headline {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-dark-text);
    margin: 0;
  }

  .ccta-subhead {
    font-size: 17px;
    line-height: 1.6;
    color: color-mix(in oklab, white 70%, transparent);
    max-width: 560px;
    margin: 14px 0 0;
  }

  /* ─── Install chip (dark-surface variant) ─── */
  .ccta-install {
    display: inline-flex;
    align-items: center;
    gap: 0;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 4px 4px 4px 20px;
    margin-top: 32px;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .ccta-install:hover {
    border-color: oklch(0.65 0.16 45 / 0.4);
    box-shadow: var(--focus-ring-accent);
  }

  .ccta-install-cmd {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-dark-text);
    user-select: all;
    letter-spacing: -0.01em;
  }

  .ccta-copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.35);
    border-radius: 6px;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
    margin-left: 8px;
    flex-shrink: 0;
  }

  .ccta-copy-btn:hover {
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.06);
  }

  .ccta-copy-btn .ccta-check-icon {
    display: none;
    color: var(--color-success);
  }

  .ccta-copy-btn.copied .ccta-copy-icon {
    display: none;
  }

  .ccta-copy-btn.copied .ccta-check-icon {
    display: block;
    animation: ccta-check-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes ccta-check-pop {
    0%   { transform: scale(0); opacity: 0; }
    60%  { transform: scale(1.2); }
    100% { transform: scale(1); opacity: 1; }
  }

  /* ─── CTA button row ─── */
  .ccta-actions {
    display: flex;
    gap: 14px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  /* ─── Responsive ─── */
  @media (max-width: 640px) {
    .ccta-section {
      padding: 80px 20px;
    }

    .ccta-blob-1 { width: 380px; height: 380px; }
    .ccta-blob-2 { width: 320px; height: 320px; }
    .ccta-blob-3 { width: 260px; height: 260px; }

    .ccta-actions {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }

    .ccta-actions .btn-accent,
    .ccta-actions .btn-secondary-dark {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ccta-blob {
      animation: none;
    }
  }
</style>

<script>
  import { copyToClipboard } from '../../scripts/clipboard';

  document.querySelectorAll<HTMLButtonElement>('#cta .ccta-copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = btn.dataset.copy ?? '';
      copyToClipboard(text).then(() => {
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 1500);
      }).catch(() => {
        btn.setAttribute('aria-label', 'Copy failed');
        setTimeout(() => btn.setAttribute('aria-label', 'Copy install command'), 2000);
      });
    });
  });
</script>

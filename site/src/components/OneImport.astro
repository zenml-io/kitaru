---
// OneImport.astro — One-import swap with OpenAI Agents SDK and Anthropic Agent SDK
---

<section id="one-import" class="dark-section section-pad one-import-section">
  <div class="section-inner">
    <span class="section-eyebrow" data-reveal>WORKS WITH YOUR AGENT SDK</span>
    <h2 class="section-title one-import-title" data-reveal data-reveal-delay="1">
      One import. Any agent SDK.
    </h2>
    <p class="one-import-desc" data-reveal data-reveal-delay="2">
      The model providers are building their own harnesses. Use them. Keep your agent, your sandbox, your manifest exactly as they are. Swap one import and get checkpointed execution, artifact tracking, and deployment &mdash; without changing a line of your agent code.
    </p>

    <!-- Tabs -->
    <div class="one-import-tabs" role="tablist" data-reveal data-reveal-delay="3">
      <button class="one-import-tab is-active" role="tab" aria-selected="true" data-tab="openai">
        <span class="one-import-tab-logo" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5Z"/></svg>
        </span>
        OpenAI Agents SDK
      </button>
      <button class="one-import-tab" role="tab" aria-selected="false" data-tab="anthropic">
        <span class="one-import-tab-logo" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13.827 3.52h3.603L24 20h-3.603l-6.57-16.48zm-7.258 0h3.767L16.906 20h-3.674l-1.343-3.461H5.017l-1.344 3.46H0L6.57 3.522zm4.132 9.959L8.453 7.687 6.205 13.48H10.7z"/></svg>
        </span>
        Anthropic Agent SDK
      </button>
      <button class="one-import-tab" role="tab" aria-selected="false" data-tab="pydanticai">
        <span class="one-import-tab-logo" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        </span>
        PydanticAI
      </button>
      <button class="one-import-tab" role="tab" aria-selected="false" data-tab="custom">
        <span class="one-import-tab-logo" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        </span>
        Custom &mdash; no framework
      </button>
    </div>

    <!-- Panels -->
    <div class="one-import-panels" data-reveal data-reveal-delay="4">

      <!-- OpenAI panel -->
      <div class="one-import-panel is-active" id="panel-openai" role="tabpanel">
        <div class="one-import-codes">
          <div class="one-import-code">
            <div class="one-import-code-header">
              <span class="one-import-code-label">Before</span>
              <span class="one-import-code-filename">agent.py</span>
            </div>
            <pre class="one-import-code-pre code-syntax"><code><span class="kw">from</span> agents <span class="kw">import</span> Runner
<span class="kw">from</span> agents.sandbox <span class="kw">import</span> SandboxAgent, Manifest

agent <span class="op">=</span> <span class="fn">SandboxAgent</span>(
    name<span class="op">=</span><span class="str">"Compliance Reviewer"</span>,
    model<span class="op">=</span><span class="str">"gpt-5.4"</span>,
    default_manifest<span class="op">=</span>manifest,
)

result <span class="op">=</span> <span class="kw">await</span> Runner.<span class="fn">run</span>(agent, task)</code></pre>
          </div>
          <div class="one-import-arrow" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </div>
          <div class="one-import-code is-after">
            <div class="one-import-code-header">
              <span class="one-import-code-label is-after">With Kitaru</span>
              <span class="one-import-code-filename">agent.py</span>
            </div>
            <pre class="one-import-code-pre code-syntax"><code><span class="kw">from</span> kitaru.integrations.openai <span class="kw">import</span> KitaruRunner
<span class="kw">from</span> agents.sandbox <span class="kw">import</span> SandboxAgent, Manifest

agent <span class="op">=</span> <span class="fn">SandboxAgent</span>(
    name<span class="op">=</span><span class="str">"Compliance Reviewer"</span>,
    model<span class="op">=</span><span class="str">"gpt-5.4"</span>,
    default_manifest<span class="op">=</span>manifest,
)

result <span class="op">=</span> <span class="kw">await</span> KitaruRunner.<span class="fn">run</span>(agent, task)</code></pre>
          </div>
        </div>
      </div>

      <!-- Anthropic panel -->
      <div class="one-import-panel" id="panel-anthropic" role="tabpanel" hidden>
        <div class="one-import-codes">
          <div class="one-import-code">
            <div class="one-import-code-header">
              <span class="one-import-code-label">Before</span>
              <span class="one-import-code-filename">agent.py</span>
            </div>
            <pre class="one-import-code-pre code-syntax"><code><span class="kw">from</span> claude_agent_sdk <span class="kw">import</span> query, ClaudeAgentOptions

options <span class="op">=</span> <span class="fn">ClaudeAgentOptions</span>(
    system_prompt<span class="op">=</span><span class="str">"You are a compliance reviewer."</span>,
    allowed_tools<span class="op">=</span>[<span class="str">"search_docs"</span>, <span class="str">"fetch_policy"</span>],
)

<span class="kw">async for</span> msg <span class="kw">in</span> <span class="fn">query</span>(prompt<span class="op">=</span>task, options<span class="op">=</span>options):
    process(msg)</code></pre>
          </div>
          <div class="one-import-arrow" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </div>
          <div class="one-import-code is-after">
            <div class="one-import-code-header">
              <span class="one-import-code-label is-after">With Kitaru</span>
              <span class="one-import-code-filename">agent.py</span>
            </div>
            <pre class="one-import-code-pre code-syntax"><code><span class="kw">from</span> kitaru.integrations.claude <span class="kw">import</span> kitaru_query
<span class="kw">from</span> claude_agent_sdk <span class="kw">import</span> ClaudeAgentOptions

options <span class="op">=</span> <span class="fn">ClaudeAgentOptions</span>(
    system_prompt<span class="op">=</span><span class="str">"You are a compliance reviewer."</span>,
    allowed_tools<span class="op">=</span>[<span class="str">"search_docs"</span>, <span class="str">"fetch_policy"</span>],
)

<span class="kw">async for</span> msg <span class="kw">in</span> <span class="fn">kitaru_query</span>(prompt<span class="op">=</span>task, options<span class="op">=</span>options):
    process(msg)</code></pre>
          </div>
        </div>
      </div>

      <!-- PydanticAI panel -->
      <div class="one-import-panel" id="panel-pydanticai" role="tabpanel" hidden>
        <div class="one-import-codes">
          <div class="one-import-code">
            <div class="one-import-code-header">
              <span class="one-import-code-label">Before</span>
              <span class="one-import-code-filename">agent.py</span>
            </div>
            <pre class="one-import-code-pre code-syntax"><code><span class="kw">from</span> pydantic_ai <span class="kw">import</span> Agent

agent <span class="op">=</span> <span class="fn">Agent</span>(
    <span class="str">"openai:gpt-5.4"</span>,
    system_prompt<span class="op">=</span><span class="str">"You are a compliance reviewer."</span>,
    tools<span class="op">=</span>[search_docs, fetch_policy],
)

result <span class="op">=</span> <span class="kw">await</span> agent.<span class="fn">run</span>(task)</code></pre>
          </div>
          <div class="one-import-arrow" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </div>
          <div class="one-import-code is-after">
            <div class="one-import-code-header">
              <span class="one-import-code-label is-after">With Kitaru</span>
              <span class="one-import-code-filename">agent.py</span>
            </div>
            <pre class="one-import-code-pre code-syntax"><code><span class="kw">from</span> kitaru.integrations.pydanticai <span class="kw">import</span> kitaru_agent
<span class="kw">from</span> pydantic_ai <span class="kw">import</span> Agent

agent <span class="op">=</span> <span class="fn">kitaru_agent</span>(<span class="fn">Agent</span>(
    <span class="str">"openai:gpt-5.4"</span>,
    system_prompt<span class="op">=</span><span class="str">"You are a compliance reviewer."</span>,
    tools<span class="op">=</span>[search_docs, fetch_policy],
))

result <span class="op">=</span> <span class="kw">await</span> agent.<span class="fn">run</span>(task)</code></pre>
          </div>
        </div>
      </div>

      <!-- Custom panel (no framework) -->
      <div class="one-import-panel" id="panel-custom" role="tabpanel" hidden>
        <div class="one-import-codes">
          <div class="one-import-code">
            <div class="one-import-code-header">
              <span class="one-import-code-label">Before</span>
              <span class="one-import-code-filename">agent.py</span>
            </div>
            <pre class="one-import-code-pre code-syntax"><code><span class="kw">from</span> anthropic <span class="kw">import</span> Anthropic

client <span class="op">=</span> <span class="fn">Anthropic</span>()

<span class="kw">def</span> <span class="fn">my_agent</span>(task: <span class="var">str</span>) <span class="op">-></span> <span class="var">str</span>:
    plan <span class="op">=</span> <span class="fn">analyze</span>(client, task)
    <span class="cmt"># crash here? everything above is lost.</span>
    result <span class="op">=</span> <span class="fn">execute</span>(client, plan)
    <span class="kw">return</span> result</code></pre>
          </div>
          <div class="one-import-arrow" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </div>
          <div class="one-import-code is-after">
            <div class="one-import-code-header">
              <span class="one-import-code-label is-after">With Kitaru</span>
              <span class="one-import-code-filename">agent.py</span>
            </div>
            <pre class="one-import-code-pre code-syntax"><code><span class="kw">from</span> kitaru <span class="kw">import</span> flow, checkpoint
<span class="kw">from</span> anthropic <span class="kw">import</span> Anthropic

client <span class="op">=</span> <span class="fn">Anthropic</span>()

<span class="dec">@flow</span>
<span class="kw">def</span> <span class="fn">my_agent</span>(task: <span class="var">str</span>) <span class="op">-></span> <span class="var">str</span>:
    plan <span class="op">=</span> <span class="fn">checkpoint</span>(analyze)(client, task)
    result <span class="op">=</span> <span class="fn">checkpoint</span>(execute)(client, plan)
    <span class="kw">return</span> result</code></pre>
          </div>
        </div>
      </div>

    </div>

    <!-- What you get -->
    <div class="one-import-bullets" data-reveal data-reveal-delay="5">
      <div class="one-import-bullet">
        <span class="one-import-bullet-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
        <div>
          <strong>Checkpointed execution.</strong>
          Every LLM call and tool invocation persisted. Container dies? Resume from the last checkpoint.
        </div>
      </div>
      <div class="one-import-bullet">
        <span class="one-import-bullet-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
        <div>
          <strong>Artifact tracking.</strong>
          Every input, output, and intermediate result versioned. Diffable across runs. Full lineage.
        </div>
      </div>
      <div class="one-import-bullet">
        <span class="one-import-bullet-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
        <div>
          <strong>Human-in-the-loop.</strong>
          Pause mid-run for approval. Resume hours or days later with full context intact.
        </div>
      </div>
      <div class="one-import-bullet">
        <span class="one-import-bullet-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
        <div>
          <strong>Deployment included.</strong>
          <code>kitaru deploy</code> pushes your agent to Fargate, Cloud Run, or Kubernetes. Your infra, your control.
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .one-import-section {
    position: relative;
  }

  .one-import-title {
    color: var(--color-dark-text);
  }

  .one-import-desc {
    max-width: 720px;
    margin: 16px 0 40px;
    color: oklch(1 0 0 / 0.7);
    font-size: clamp(0.98rem, 1.5vw, 1.08rem);
    line-height: 1.7;
    font-weight: 300;
  }

  /* ─── Tabs ─── */
  .one-import-tabs {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    background: oklch(1 0 0 / 0.04);
    border: 1px solid oklch(1 0 0 / 0.08);
    border-radius: 10px;
    margin-bottom: 28px;
  }

  .one-import-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 7px;
    background: transparent;
    border: none;
    color: oklch(1 0 0 / 0.55);
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .one-import-tab:hover {
    color: oklch(1 0 0 / 0.85);
  }

  .one-import-tab.is-active {
    background: oklch(0.65 0.16 45 / 0.18);
    color: oklch(1 0 0);
    box-shadow: 0 0 0 1px oklch(0.65 0.16 45 / 0.4);
  }

  .one-import-tab-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.75;
  }

  .one-import-tab.is-active .one-import-tab-logo {
    opacity: 1;
  }

  /* ─── Code panels ─── */
  .one-import-panel {
    display: block;
  }

  .one-import-panel[hidden] {
    display: none;
  }

  .one-import-codes {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px;
    align-items: stretch;
  }

  .one-import-code {
    background: oklch(0.16 0.015 60);
    border: 1px solid oklch(1 0 0 / 0.08);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .one-import-code.is-after {
    border-color: oklch(0.65 0.16 45 / 0.3);
    box-shadow: 0 0 0 3px oklch(0.65 0.16 45 / 0.05);
  }

  .one-import-code-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid oklch(1 0 0 / 0.06);
  }

  .one-import-code-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: oklch(1 0 0 / 0.4);
  }

  .one-import-code-label.is-after {
    color: var(--color-accent);
  }

  .one-import-code-filename {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: oklch(1 0 0 / 0.35);
  }

  .one-import-code-pre {
    padding: 20px;
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--color-dark-text);
    flex: 1;
    -webkit-overflow-scrolling: touch;
  }

  .one-import-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    opacity: 0.7;
  }

  /* ─── Bullets ─── */
  .one-import-bullets {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 40px;
  }

  .one-import-bullet {
    display: flex;
    gap: 14px;
    padding: 20px 22px;
    border-radius: 10px;
    background: oklch(0.22 0.018 60);
    border: 1px solid oklch(1 0 0 / 0.14);
    color: oklch(1 0 0 / 0.92);
    font-size: 0.92rem;
    line-height: 1.6;
    transition: border-color 0.2s, background 0.2s;
  }

  .one-import-bullet:hover {
    border-color: oklch(0.65 0.16 45 / 0.5);
    background: oklch(0.23 0.02 60);
  }

  .one-import-bullet strong {
    color: oklch(1 0 0);
    font-weight: 600;
    display: block;
    margin-bottom: 4px;
    font-size: 0.98rem;
    letter-spacing: -0.005em;
  }

  .one-import-bullet code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: oklch(0.78 0.14 55);
    background: oklch(0.65 0.16 45 / 0.18);
    padding: 1px 6px;
    border-radius: 4px;
    font-weight: 500;
  }

  .one-import-bullet-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: oklch(0.65 0.16 45 / 0.25);
    color: oklch(0.85 0.14 55);
    margin-top: 1px;
  }

  /* ─── Responsive ─── */
  @media (max-width: 900px) {
    .one-import-codes {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .one-import-arrow {
      transform: rotate(90deg);
      padding: 4px 0;
    }
  }

  @media (max-width: 768px) {
    .one-import-bullets {
      grid-template-columns: 1fr;
    }

    .one-import-tabs {
      width: 100%;
      overflow-x: auto;
    }

    .one-import-tab {
      flex-shrink: 0;
    }

    .one-import-code-pre {
      font-size: 0.72rem;
      padding: 16px;
    }
  }
</style>

<script>
  const section = document.getElementById('one-import');
  if (section) {
    const tabs = section.querySelectorAll<HTMLButtonElement>('.one-import-tab');
    const panels = section.querySelectorAll<HTMLElement>('.one-import-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        if (!target) return;

        tabs.forEach(t => {
          const isActive = t === tab;
          t.classList.toggle('is-active', isActive);
          t.setAttribute('aria-selected', String(isActive));
        });

        panels.forEach(panel => {
          const isActive = panel.id === `panel-${target}`;
          panel.classList.toggle('is-active', isActive);
          if (isActive) {
            panel.removeAttribute('hidden');
          } else {
            panel.setAttribute('hidden', '');
          }
        });
      });
    });
  }
</script>

---
// Deploy.astro — Terminal-led "run it" section, with a forward-looking roadmap nudge
---

<section id="deploy" class="section-pad-compact deploy-section">
  <div class="section-inner">
    <span class="section-eyebrow" data-reveal>OPEN SOURCE</span>
    <h2 class="section-title" data-reveal data-reveal-delay="1">
      From laptop to enterprise. Same OSS stack.
    </h2>
    <p class="deploy-lede" data-reveal data-reveal-delay="2">
      Kitaru ships as a CLI, a dashboard, and a scalable execution server. All open source, all self-hosted. Runs on your laptop today. Scales to your enterprise cloud when you need it.
    </p>

    <div class="deploy-layout">
      <div class="deploy-terminal" data-reveal data-reveal-delay="3">
        <div class="deploy-terminal-header">
          <div class="deploy-terminal-dots">
            <span class="code-dot"></span>
            <span class="code-dot"></span>
            <span class="code-dot"></span>
          </div>
          <span class="deploy-terminal-title">~/your-agent</span>
        </div>
        <pre class="deploy-terminal-pre"><code><span class="deploy-cmt"># install and log in to a local server</span>
<span class="deploy-prompt">$</span> uv add kitaru
<span class="deploy-prompt">$</span> kitaru login
<span class="deploy-ok">✓ Connected to local server at http://localhost:9090</span>

<span class="deploy-cmt"># initialize and run your first flow</span>
<span class="deploy-prompt">$</span> kitaru init
<span class="deploy-prompt">$</span> python agent.py
<span class="deploy-ok">✓ execution 4f2a complete (6 checkpoints persisted)</span>

<span class="deploy-cmt"># replay from any checkpoint</span>
<span class="deploy-prompt">$</span> kitaru executions replay 4f2a --from process_data
<span class="deploy-ok">✓ replayed from checkpoint process_data</span></code></pre>
      </div>

      <figure class="deploy-dashboard" data-reveal="fade-right" data-reveal-delay="4">
        <img
          src="/dashboard.png"
          alt="Kitaru dashboard showing an execution with its checkpoints"
          loading="lazy"
          decoding="async"
          width="1440"
          height="900"
        />
        <figcaption class="deploy-dashboard-caption">Dashboard, replay, logs, and cost tracking ship with the server.</figcaption>
      </figure>
    </div>

    <div class="deploy-links-row" data-reveal data-reveal-delay="5">
      <a href="https://github.com/zenml-io/kitaru" target="_blank" rel="noopener" class="deploy-link">
        Star on GitHub
        <span aria-hidden="true">→</span>
      </a>
      <a href="/roadmap" class="deploy-link">
        See the roadmap
        <span aria-hidden="true">→</span>
      </a>
    </div>

  </div>
</section>

<style>
  .deploy-section {
    background: var(--color-bg);
  }

  .deploy-lede {
    max-width: 680px;
    margin-top: 14px;
    margin-bottom: 32px;
    font-size: clamp(0.95rem, 1.5vw, 1.08rem);
    line-height: 1.6;
    color: var(--color-secondary);
  }

  /* ─── Two-column layout ─── */
  .deploy-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(260px, 1fr);
    gap: 28px;
    align-items: stretch;
  }

  /* ─── Terminal ─── */
  .deploy-terminal {
    background: oklch(0.16 0.015 60);
    border: 1px solid oklch(1 0 0 / 0.08);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .deploy-terminal-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid oklch(1 0 0 / 0.06);
  }

  .deploy-terminal-dots {
    display: flex;
    gap: 6px;
  }

  .deploy-terminal-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: oklch(1 0 0 / 0.4);
  }

  .deploy-terminal-pre {
    padding: 18px 22px;
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.75;
    color: var(--color-dark-text);
  }

  .deploy-prompt {
    color: oklch(0.72 0.14 55);
    user-select: none;
    margin-right: 8px;
  }

  .deploy-cmt {
    color: oklch(0.6 0.015 60);
    font-style: italic;
  }

  .deploy-str {
    color: oklch(0.78 0.1 155);
  }

  .deploy-ok {
    color: oklch(0.7 0.12 155);
    font-size: 0.78rem;
  }

  /* ─── Dashboard screenshot ─── */
  .deploy-dashboard {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }

  .deploy-dashboard img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    box-shadow: 0 8px 28px oklch(0 0 0 / 0.06);
    background: var(--color-surface);
  }

  .deploy-dashboard-caption {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--color-muted);
    font-style: italic;
  }

  /* ─── Links row (below the layout) ─── */
  .deploy-links-row {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 28px;
    margin-top: 20px;
  }

  .deploy-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    transition: gap 0.2s;
  }

  .deploy-link:hover {
    gap: 10px;
  }

  @media (max-width: 900px) {
    .deploy-layout {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 640px) {
    .deploy-terminal-pre {
      font-size: 0.74rem;
      padding: 14px 16px;
    }
  }
</style>

---
// SocialProof.astro — Lineage proof, capability proof, and background links
---

<section id="social-proof" class="social-proof-section">
  <div class="social-proof-inner">
    <h2 class="sr-only">Foundations and proof for Kitaru</h2>

    <div class="sp-header" data-reveal>
      <span class="section-eyebrow">FOUNDATIONS</span>
      <div class="sp-companies">
        <span class="sp-label">ZenML lineage</span>
        <a class="sp-company" href="https://www.zenml.io/case-study/jetbrains" target="_blank" rel="noopener">JetBrains</a>
        <span class="sp-sep" aria-hidden="true"></span>
        <a class="sp-company" href="https://www.zenml.io/case-study/adeo-leroy-merlin" target="_blank" rel="noopener">Adeo</a>
        <span class="sp-sep" aria-hidden="true"></span>
        <a class="sp-company" href="https://www.zenml.io/case-study/brevo" target="_blank" rel="noopener">Brevo</a>
      </div>
    </div>

    <p class="sp-tagline" data-reveal data-reveal-delay="1">
      We saw this happen before in MLOps. Agent runtime is at the same point now.
    </p>

    <div class="sp-stats">
      <div class="sp-stat" data-reveal="scale-up" data-reveal-delay="2">
        <div class="sp-stat-accent" aria-hidden="true"></div>
        <span class="sp-stat-number" data-count-to="5" data-suffix="+">5+</span>
          <span class="sp-stat-unit">years building production workflow infrastructure</span>
      </div>

      <div class="sp-stat" data-reveal="scale-up" data-reveal-delay="3">
        <div class="sp-stat-accent" aria-hidden="true"></div>
        <span class="sp-stat-number sp-stat-text">Built</span>
        <span class="sp-stat-unit">in Kitaru today</span>
      </div>
    </div>

    <div class="sp-articles" data-reveal data-reveal-delay="4">
        <span class="sp-articles-label">From the blog</span>
      <div class="sp-articles-grid">
        <a class="sp-article" href="/blog/from-zenml-to-kitaru/">
          <span class="sp-article-kind">Origin story</span>
          <h3 class="sp-article-title">From ZenML to Kitaru</h3>
          <p class="sp-article-summary">Why agent runtime needed a new interface, and what we kept from production ML infrastructure.</p>
          <span class="sp-article-cta">Read post <span aria-hidden="true">→</span></span>
        </a>
        <a class="sp-article" href="/blog/why-agents-need-durable-execution/">
          <span class="sp-article-kind">Concept</span>
          <h3 class="sp-article-title">Why agents need durable execution</h3>
          <p class="sp-article-summary">Crashes, timeouts, and human waits are routine. Without runtime durability, every failure means starting over.</p>
          <span class="sp-article-cta">Read post <span aria-hidden="true">→</span></span>
        </a>
        <a class="sp-article" href="/blog/agents-need-more-than-traces/">
          <span class="sp-article-kind">Perspective</span>
          <h3 class="sp-article-title">Agents need more than traces</h3>
          <p class="sp-article-summary">Traces explain what happened. Runtime artifacts, replay, and approval gates let you do something about it.</p>
          <span class="sp-article-cta">Read post <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .social-proof-section {
    background: var(--color-accent-light);
    padding: 48px 0 56px;
    position: relative;
    overflow: hidden;
  }

  .social-proof-section::before {
    content: '';
    position: absolute;
    top: 0;
    right: -10%;
    width: 60%;
    height: 100%;
    background: radial-gradient(ellipse at 70% 30%, oklch(0.65 0.16 45 / 0.04) 0%, transparent 70%);
    pointer-events: none;
  }

  .social-proof-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 80px);
    position: relative;
  }

  .sp-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 14px;
  }

  .sp-companies {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .sp-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .sp-company {
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary);
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .sp-company:hover {
    opacity: 0.7;
  }

  .sp-sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .sp-tagline {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 600;
    color: var(--color-primary);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 10px;
    max-width: 860px;
  }

  .sp-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: oklch(0.15 0.02 60 / 0.08);
    border-radius: 16px;
    overflow: hidden;
  }

  .sp-stat {
    background: var(--color-surface);
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .sp-stat-accent {
    position: absolute;
    top: 0;
    left: 28px;
    right: 28px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), oklch(0.68 0.08 55));
    border-radius: 0 0 2px 2px;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .sp-stat:hover .sp-stat-accent {
    opacity: 1;
  }

  .sp-stat-number {
    font-size: clamp(40px, 5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--color-primary);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .sp-stat-text {
    font-size: clamp(26px, 3.2vw, 36px);
    letter-spacing: -0.025em;
  }

  .sp-stat-unit {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-top: 4px;
    margin-bottom: 10px;
  }

  .sp-articles {
    margin-top: 24px;
  }

  .sp-articles-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 10px;
  }

  .sp-articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .sp-article {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px 14px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    text-decoration: none;
    color: var(--color-primary);
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .sp-article:hover {
    border-color: oklch(0.65 0.16 45 / 0.35);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px oklch(0 0 0 / 0.05);
  }

  .sp-article-kind {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 2px;
  }

  .sp-article-title {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-primary);
    margin: 0;
  }

  .sp-article-summary {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-secondary);
    margin: 0;
    flex: 1;
  }

  .sp-article-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-accent);
    margin-top: 2px;
    transition: gap 0.2s;
  }

  .sp-article:hover .sp-article-cta {
    gap: 8px;
  }

  @media (max-width: 768px) {
    .social-proof-section {
      padding: 80px 0;
    }

    .sp-tagline {
      font-size: 22px;
      line-height: 1.25;
      margin-bottom: 12px;
    }

    .sp-stats {
      grid-template-columns: 1fr;
    }

    .sp-stat {
      padding: 32px 28px;
    }

    .sp-stat-number {
      font-size: 52px;
    }

    .sp-stat-text {
      font-size: 32px;
    }

    .sp-stat-accent {
      left: 28px;
      right: 28px;
    }

    .sp-articles-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .social-proof-section { padding: 60px 0; }
    .sp-tagline { font-size: 19px; margin-bottom: 10px; }
    .sp-stat { padding: 24px 20px; }
    .sp-stat-number { font-size: 44px; }
    .sp-stat-text { font-size: 28px; }
    .sp-stat-accent { left: 20px; right: 20px; }
  }
</style>

<script>
  const counters = document.querySelectorAll<HTMLElement>('.sp-stat-number[data-count-to]');
  if (counters.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.countTo ?? '0', 10);
        const suffix = el.dataset.suffix ?? '';
        const duration = 1200;
        const start = performance.now();

        function tick(now: number) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = Math.round(eased * target);
          el.textContent = current + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        }

        requestAnimationFrame(tick);
        observer.unobserve(el);
      });
    }, { threshold: 0.5 });

    counters.forEach(el => observer.observe(el));
  }
</script>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const comparisons = (await getCollection('comparisons', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const openSourceFeatures = [
  'All primitives — flow, checkpoint, wait, llm, memory',
  'Framework adapters and bundled MCP server',
  'Replay, retry, resume, and cancel (CLI, SDK, dashboard)',
  'Local execution and remote orchestrators (K8s, Vertex, SageMaker, AzureML)',
  'Self-hosted server and dashboard',
  'Community support on GitHub and Slack',
];

const enterpriseFeatures = [
  'Trigger flows from the dashboard, API, schedules, or webhooks',
  'Distributed execution across deployments — replay, retry, and resume at scale',
  'Managed autoscaling workers, queues, and concurrency controls',
  'SAML / OIDC SSO and SCIM provisioning',
  'Custom RBAC roles and org-wide audit logs',
  'Multi-region and air-gapped deployment',
  'SOC 2 Type II and ISO 27001',
  '24/7 dedicated support and a named solutions engineer',
];

type Mark = 'yes' | 'no' | (string & {});
type Row = { feature: string; oss: Mark; enterprise: Mark };
type Section = { title: string; rows: Row[] };

const compareSections: Section[] = [
  {
    title: 'Core SDK',
    rows: [
      { feature: 'All primitives (flow, checkpoint, wait, llm, memory)', oss: 'yes', enterprise: 'yes' },
      { feature: 'Framework adapters + bundled MCP server', oss: 'yes', enterprise: 'yes' },
      { feature: 'Replay, retry, resume, cancel (CLI, SDK, dashboard)', oss: 'yes', enterprise: 'yes' },
      { feature: 'Distributed execution across deployments (not single-node)', oss: 'no', enterprise: 'yes' },
      { feature: 'High-concurrency replay / retry / resume at scale', oss: 'no', enterprise: 'yes' },
      { feature: 'Flow executions', oss: 'Unlimited', enterprise: 'Unlimited' },
    ],
  },
  {
    title: 'Deployment',
    rows: [
      { feature: 'Local execution (in-process)', oss: 'yes', enterprise: 'yes' },
      { feature: 'Self-hosted server', oss: 'yes', enterprise: 'yes' },
      { feature: 'Remote orchestrators (K8s, Vertex, SageMaker, AzureML)', oss: 'yes', enterprise: 'yes' },
      { feature: 'CLI + SDK trigger', oss: 'yes', enterprise: 'yes' },
      { feature: 'Dashboard trigger', oss: 'no', enterprise: 'yes' },
      { feature: 'REST API trigger', oss: 'no', enterprise: 'yes' },
      { feature: 'Scheduled trigger (cron)', oss: 'no', enterprise: 'yes' },
      { feature: 'Webhook trigger', oss: 'no', enterprise: 'yes' },
      { feature: 'Managed autoscaling workers + queues', oss: 'no', enterprise: 'yes' },
      { feature: 'Concurrency + rate-limit controls', oss: 'no', enterprise: 'yes' },
      { feature: 'Multi-region deployment', oss: 'no', enterprise: 'yes' },
      { feature: 'Air-gapped / on-prem deployment', oss: 'no', enterprise: 'yes' },
    ],
  },
  {
    title: 'Governance',
    rows: [
      { feature: 'Local workspace and secrets', oss: 'yes', enterprise: 'yes' },
      { feature: 'SAML / OIDC SSO + SCIM', oss: 'no', enterprise: 'yes' },
      { feature: 'Custom RBAC roles', oss: 'no', enterprise: 'yes' },
      { feature: 'Org-wide audit logs', oss: 'no', enterprise: 'yes' },
    ],
  },
  {
    title: 'Security & Compliance',
    rows: [
      { feature: 'Self-managed encryption keys (BYOK)', oss: 'no', enterprise: 'yes' },
      { feature: 'SOC 2 Type II', oss: 'no', enterprise: 'yes' },
      { feature: 'ISO 27001', oss: 'no', enterprise: 'yes' },
      { feature: 'Annual security review', oss: 'no', enterprise: 'yes' },
    ],
  },
  {
    title: 'Support',
    rows: [
      { feature: 'Community (GitHub, Slack)', oss: 'yes', enterprise: 'yes' },
      { feature: 'Priority support with SLA', oss: 'no', enterprise: 'yes' },
      { feature: 'Dedicated solutions engineer', oss: 'no', enterprise: 'yes' },
    ],
  },
];

const faq = [
  {
    q: 'Is Kitaru really free?',
    a: 'Yes. The full SDK is open source under Apache 2.0. Self-host it forever, no usage limits. Enterprise adds distributed execution at scale, dashboard / API / scheduled / webhook triggers, SSO, RBAC, and audit logs.',
    open: true,
  },
  {
    q: "What's the difference between Open Source and Enterprise?",
    a: 'Same SDK, same primitives. Open source runs your flows on a single-node server you operate yourself. Enterprise adds distributed execution across deployments — so you can replay, retry, and resume at scale — plus dashboard, API, scheduled, and webhook triggers, SSO, custom RBAC roles, org-wide audit logs, multi-region and air-gapped deployment, and SOC 2 Type II / ISO 27001.',
    open: false,
  },
  {
    q: 'Can I run Kitaru on my own cloud?',
    a: 'Yes. Self-host the server in your own VPC, point it at S3, GCS, or Azure Blob, and run flows on Kubernetes, Vertex, SageMaker, or AzureML. Enterprise customers can run a dedicated control plane in their own region or fully air-gapped.',
    open: false,
  },
  {
    q: 'Do I have to share my agent data with Kitaru?',
    a: 'No. In the open-source path, executions, artifacts, and prompts stay inside your infrastructure end-to-end. Enterprise stores execution metadata and pointers — your artifact store stays under your control.',
    open: false,
  },
  {
    q: 'Can I migrate from Open Source to Enterprise later?',
    a: "Yes. The schema is the same on both sides, so flows, checkpoints, memory scopes, and stack configs port over. We'll help script the cutover during onboarding.",
    open: false,
  },
  {
    q: 'How do I get support?',
    a: 'Open source: GitHub Discussions, GitHub Issues, and the community Slack. Enterprise: a dedicated solutions engineer, a private Slack Connect channel, and an SLA on response and resolution times.',
    open: false,
  },
];
---

<Base
  title="Pricing — Kitaru | Open source agents, enterprise when you scale"
  description="The full Kitaru SDK is open source under Apache 2.0. Add SSO, audit, and a hosted control plane when your team needs them."
>
  <Nav />
  <main id="main-content" class="pricing">
    <section class="pricing-hero">
      <div class="pricing-hero-glow" aria-hidden="true"></div>
      <div class="pricing-hero-inner">
        <span class="pricing-eyebrow-pill" data-reveal>
          <span class="pulse-dot" aria-hidden="true"></span>
          <span>Pricing · Open source forever</span>
        </span>
        <h1 class="pricing-title" data-reveal data-reveal-delay="1">
          Open by default. Enterprise when you scale.
        </h1>
        <p class="pricing-lead" data-reveal data-reveal-delay="2">
          The full Kitaru SDK is open source under Apache 2.0. Add SSO, audit, and a
          hosted control plane when your team needs them.
        </p>
      </div>
    </section>

    <section class="pricing-plans">
      <div class="pricing-plans-inner">
        <article class="pricing-card" data-reveal>
          <header class="pricing-card-head">
            <h2 class="pricing-card-name">Open Source</h2>
            <div class="pricing-card-price">
              <span class="pricing-card-amount">$0</span>
              <span class="pricing-card-cadence">/ forever</span>
            </div>
            <p class="pricing-card-tagline">Self-hosted. Apache 2.0. Yours.</p>
          </header>
          <div class="pricing-card-divider" aria-hidden="true"></div>
          <div class="pricing-card-body">
            <p class="pricing-card-bullets-label">Everything in the SDK:</p>
            <ul class="pricing-card-bullets">
              {openSourceFeatures.map((item) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <a href="https://github.com/zenml-io/kitaru" target="_blank" rel="noopener noreferrer" class="pricing-card-cta pricing-card-cta--secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
            <span>Star on GitHub</span>
            <span class="pricing-card-cta-arrow" aria-hidden="true">→</span>
          </a>
        </article>

        <article class="pricing-card" data-reveal data-reveal-delay="1">
          <header class="pricing-card-head">
            <h2 class="pricing-card-name">Enterprise</h2>
            <div class="pricing-card-price">
              <span class="pricing-card-amount pricing-card-amount--talk">Let's talk</span>
            </div>
            <p class="pricing-card-tagline">For teams running agents in production.</p>
          </header>
          <div class="pricing-card-divider" aria-hidden="true"></div>
          <div class="pricing-card-body">
            <p class="pricing-card-bullets-label">Everything in Open Source, plus:</p>
            <ul class="pricing-card-bullets">
              {enterpriseFeatures.map((item) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <a href="/get-started" class="pricing-card-cta pricing-card-cta--primary">
            <span>Book a demo</span>
            <span class="pricing-card-cta-arrow" aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </section>

    <section class="pricing-compare">
      <div class="pricing-compare-inner">
        <header class="pricing-section-head" data-reveal>
          <span class="pricing-eyebrow">Compare plans</span>
          <h2 class="pricing-section-title">A complete look at what's included.</h2>
        </header>
        <div class="pricing-table-wrap" data-reveal data-reveal-delay="1">
          <table class="pricing-table">
            <colgroup>
              <col class="pricing-table-col-feature" />
              <col class="pricing-table-col-mark" />
              <col class="pricing-table-col-mark" />
            </colgroup>
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Feature</span></th>
                <th scope="col">Open Source</th>
                <th scope="col">Enterprise</th>
              </tr>
            </thead>
            {compareSections.map((section) => (
              <tbody>
                <tr class="pricing-table-section">
                  <th colspan="3" scope="rowgroup">{section.title}</th>
                </tr>
                {section.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.feature}</th>
                    <td>
                      {row.oss === 'yes' ? (
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                      ) : row.oss === 'no' ? (
                        <span class="pricing-table-dash" aria-label="Not included">—</span>
                      ) : (
                        <span class="pricing-table-value">{row.oss}</span>
                      )}
                    </td>
                    <td>
                      {row.enterprise === 'yes' ? (
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                      ) : row.enterprise === 'no' ? (
                        <span class="pricing-table-dash" aria-label="Not included">—</span>
                      ) : (
                        <span class="pricing-table-value">{row.enterprise}</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
        </div>
      </div>
    </section>

    <section class="pricing-stacks">
      <div class="pricing-stacks-inner">
        <header class="pricing-section-head" data-reveal>
          <span class="pricing-eyebrow">Compare</span>
          <h2 class="pricing-section-title">See how Kitaru stacks up.</h2>
          <p class="pricing-section-lead">
            Kitaru is built for AI agents specifically — see how it compares to general
            workflow tools and other agent SDKs.
          </p>
        </header>
        {comparisons.length > 0 && (
          <ul class="pricing-stacks-grid">
            {comparisons.map((entry, idx) => (
              <li>
                <a href={`/compare/${entry.id}`} class="pricing-stacks-card" data-reveal data-reveal-delay={String((idx % 3) + 1)}>
                  {entry.data.competitorLogo && (
                    <span class="pricing-stacks-card-icon" aria-hidden="true">
                      <img src={entry.data.competitorLogo} alt="" width="22" height="22" />
                    </span>
                  )}
                  <h3 class="pricing-stacks-card-title">Kitaru vs {entry.data.competitor}</h3>
                  <p>{entry.data.cardSubtitle}</p>
                  <span class="pricing-stacks-card-cta" aria-hidden="true">
                    Read comparison
                    <svg viewBox="0 0 20 20" width="14" height="14"><path fill="currentColor" d="M7.05 4.55 5.64 5.96 9.67 10l-4.03 4.04 1.41 1.41L12.5 10z"/></svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <section class="pricing-faq">
      <div class="pricing-faq-inner">
        <header class="pricing-section-head" data-reveal>
          <span class="pricing-eyebrow">FAQ</span>
          <h2 class="pricing-section-title">Frequently asked questions</h2>
        </header>
        <div class="pricing-faq-list" data-reveal data-reveal-delay="1">
          {faq.map((item) => (
            <details class="pricing-faq-item" open={item.open}>
              <summary>
                <span class="pricing-faq-q">{item.q}</span>
                <svg class="pricing-faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="pricing-faq-a">{item.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="pricing-cta" id="cta">
      <div class="pricing-cta-mesh" aria-hidden="true">
        <div class="pricing-cta-blob pricing-cta-blob-1"></div>
        <div class="pricing-cta-blob pricing-cta-blob-2"></div>
        <div class="pricing-cta-blob pricing-cta-blob-3"></div>
      </div>
      <div class="pricing-cta-inner" data-reveal>
        <span class="pricing-cta-eyebrow">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span>Get started in seconds</span>
        </span>
        <h2 class="pricing-cta-title">Ship reliable agents. Start free.</h2>
        <p class="pricing-cta-lead">Open source today. Talk to us when your team needs more.</p>
        <div class="pricing-cta-actions">
          <div class="pricing-cta-install">
            <span class="pricing-cta-install-prompt" aria-hidden="true">$</span>
            <code>pip install kitaru</code>
            <button class="pricing-cta-copy" aria-label="Copy install command" data-copy="pip install kitaru">
              <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              <svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            </button>
          </div>
          <div class="pricing-cta-buttons">
            <a href="/get-started" class="pricing-cta-primary">
              <span>Get started</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
            </a>
            <a href="https://github.com/zenml-io/kitaru" target="_blank" rel="noopener noreferrer" class="pricing-cta-secondary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
              </svg>
              <span>Star on GitHub</span>
            </a>
          </div>
        </div>
        <p class="pricing-cta-note">Open source (Apache 2.0). pip install and go.</p>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .pricing { padding-top: 0; }

  /* ─── Shared section heads ─── */
  .pricing-section-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 48px;
  }
  .pricing-section-title {
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-primary);
    margin: 12px 0 0;
  }
  .pricing-section-lead {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-secondary);
    margin: 16px auto 0;
    max-width: 580px;
  }
  .pricing-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  /* ─── Hero ─── */
  .pricing-hero {
    position: relative;
    padding: clamp(120px, 14vw, 168px) 24px clamp(48px, 5vw, 72px);
    text-align: center;
    overflow: hidden;
  }
  .pricing-hero-glow {
    position: absolute;
    top: 80px;
    left: 50%;
    width: min(720px, 90vw);
    height: 480px;
    transform: translateX(-50%);
    background: radial-gradient(circle at 50% 50%, oklch(0.65 0.16 45 / 0.10) 0%, oklch(0.65 0.16 45 / 0) 60%);
    pointer-events: none;
    z-index: 0;
  }
  .pricing-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 980px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .pricing-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }
  .pricing-eyebrow-pill .pulse-dot {
    width: 6px;
    height: 6px;
  }
  .pricing-title {
    font-size: clamp(40px, 6.5vw, 72px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--color-primary);
    margin: 0;
    max-width: 980px;
  }
  .pricing-lead {
    font-size: 18px;
    line-height: 1.55;
    color: var(--color-secondary);
    max-width: 680px;
    margin: 0;
  }

  /* ─── Plan cards ─── */
  .pricing-plans {
    padding: clamp(40px, 5vw, 64px) 24px;
  }
  .pricing-plans-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .pricing-card {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 40px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
  }
  .pricing-card-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .pricing-card-name {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-primary);
    margin: 0;
  }
  .pricing-card-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .pricing-card-amount {
    font-size: clamp(44px, 5vw, 56px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1;
    color: var(--color-primary);
  }
  .pricing-card-amount--talk {
    font-size: clamp(40px, 4.5vw, 52px);
    letter-spacing: -0.02em;
  }
  .pricing-card-cadence {
    font-size: 14px;
    color: var(--color-muted);
  }
  .pricing-card-tagline {
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-secondary);
    margin: 0;
  }
  .pricing-card-divider {
    height: 1px;
    background: var(--color-border-light);
  }
  .pricing-card-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
  }
  .pricing-card-bullets-label {
    font-size: 13px;
    color: var(--color-muted);
    margin: 0;
  }
  .pricing-card-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

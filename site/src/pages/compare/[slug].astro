---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ComparisonHero from '../../components/compare/ComparisonHero.astro';

export async function getStaticPaths() {
  const entries = await getCollection('comparisons', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description} ogImage={entry.data.ogImage}>
  <Nav />
  <main id="main-content" class="compare-page">
    <ComparisonHero
      title={entry.data.title}
      description={entry.data.description}
      competitor={entry.data.competitor}
      competitorLogo={entry.data.competitorLogo}
    />

    <article class="compare-body">
      <div class="compare-body-inner">
        <Content />
      </div>
    </article>

    <section class="compare-footer-cta">
      <div class="compare-footer-inner">
        <h2>{entry.data.ctaHeading}</h2>
        <p>No cost, no commitment. Install Kitaru and run your first durable flow in an afternoon.</p>
        <div class="compare-footer-ctas">
          <a href="/get-started" class="btn-primary">Get started</a>
          <a href="/docs" class="btn-secondary">Read the docs</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .compare-page { padding-top: 0; }
  .compare-body { padding: 40px 24px 60px; }
  .compare-body-inner {
    max-width: 820px;
    margin: 0 auto;
  }
  .compare-body-inner :global(h2) {
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 56px 0 16px;
    color: var(--color-primary);
  }
  .compare-body-inner :global(h3) {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1.3;
    margin: 36px 0 12px;
    color: var(--color-primary);
  }
  .compare-body-inner :global(p) {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-secondary);
    margin: 0 0 18px;
  }
  .compare-body-inner :global(ul) {
    padding-left: 22px;
    margin: 0 0 18px;
  }
  .compare-body-inner :global(li) {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-secondary);
    margin-bottom: 8px;
  }
  .compare-body-inner :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-primary);
  }
  /* Clear any inherited background on code inside fenced blocks so Shiki's
     theme shows through without a doubled layer. */
  .compare-body-inner :global(pre code) {
    background: transparent;
  }
  .compare-body-inner :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .compare-body-inner :global(a:hover) {
    text-decoration-thickness: 2px;
  }

  .compare-body-inner :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0 32px;
    font-size: 15px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
  }
  .compare-body-inner :global(th) {
    text-align: left;
    padding: 12px 16px;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--color-primary);
    background: var(--color-surface-warm);
    border-bottom: 1px solid var(--color-border);
  }
  .compare-body-inner :global(td) {
    padding: 12px 16px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-secondary);
    border-bottom: 1px solid var(--color-border-light);
    vertical-align: top;
  }
  .compare-body-inner :global(tr:last-child td) {
    border-bottom: none;
  }
  .compare-body-inner :global(td:first-child) {
    font-weight: 600;
    color: var(--color-primary);
    width: 28%;
  }

  .compare-footer-cta {
    padding: 80px 24px 100px;
    background: var(--color-surface-warm);
    border-top: 1px solid var(--color-border-light);
    text-align: center;
  }
  .compare-footer-inner { max-width: 640px; margin: 0 auto; }
  .compare-footer-inner h2 {
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0 0 12px;
  }
  .compare-footer-inner p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-secondary);
    margin: 0 0 28px;
  }
  .compare-footer-ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .compare-body-inner :global(.compare-inline-cta) {
    display: flex;
    justify-content: flex-start;
    margin: 24px 0 8px;
  }
</style>

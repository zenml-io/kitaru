---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ComparisonHero from '../../components/compare/ComparisonHero.astro';
import CompareToc from '../../components/compare/CompareToc.astro';
import ComparisonCta from '../../components/compare/ComparisonCta.astro';

export async function getStaticPaths() {
  const entries = await getCollection('comparisons', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Hardcoded default sections — anchor targets (#when-to-use, #features, #code, #cta)
// will only work once MDX adds explicit <h2 id="..."> elements (follow-up PR).
// Until then the links are inert but not broken.
const defaultSections = [
  { id: 'when-to-use', label: 'When to use each' },
  { id: 'features', label: 'Feature comparison' },
  { id: 'code', label: 'Code comparison' },
  { id: 'cta', label: 'Get started' },
];
---

<Base title={entry.data.title} description={entry.data.description} ogImage={entry.data.ogImage}>
  <Nav />
  <main id="main-content" class="compare-page">
    <ComparisonHero
      title={entry.data.title}
      description={entry.data.description}
      competitor={entry.data.competitor}
      competitorLogo={entry.data.competitorLogo}
      competitorTagline={entry.data.competitorTagline}
    />

    <div class="compare-body">
      <!-- TOC rail occupies grid column 1 on desktop; mobile chip + scroll-progress bar
           use position: fixed and are unaffected by grid placement. -->
      <CompareToc sections={defaultSections} />
      <article class="compare-body-inner">
        <Content />
      </article>
    </div>

    <ComparisonCta headline={entry.data.ctaHeading} />
  </main>

  <!-- Mobile sticky bottom CTA bar (≤820px) -->
  <div class="compare-mobile-cta" aria-label="Quick actions" role="complementary">
    <a href="/get-started" class="btn-primary">Install Kitaru</a>
    <a href="/docs" class="btn-secondary">Docs</a>
  </div>

  <Footer />
</Base>

<style>
  .compare-page { padding-top: 0; }

  /* ─── Body layout ─── */
  /* On desktop: CSS grid with TOC rail left + article right.
     The TOC rail itself is sticky (handled inside CompareToc.astro). */
  .compare-body {
    padding: 40px 24px 60px;
    max-width: 1180px;
    margin: 0 auto;
  }

  .compare-body-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  /* Add bottom padding so mobile sticky bar never covers content */
  @media (max-width: 820px) {
    .compare-body {
      padding-bottom: 72px;
    }
  }

  /* At ≥1100px: two-column grid — TOC rail (220px) + article */
  @media (min-width: 1100px) {
    .compare-body {
      display: grid;
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 48px;
      padding: 48px 48px 80px;
      max-width: 1240px;
    }

    /* Article caps at 820px within its grid cell */
    .compare-body-inner {
      max-width: 820px;
      margin: 0; /* let grid alignment do the work */
    }
  }

  /* ─── Article typography ─── */
  .compare-body-inner :global(h2) {
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 56px 0 16px;
    color: var(--color-primary);
  }
  .compare-body-inner :global(h3) {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1.3;
    margin: 36px 0 12px;
    color: var(--color-primary);
  }
  .compare-body-inner :global(p) {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-secondary);
    margin: 0 0 18px;
  }
  .compare-body-inner :global(ul) {
    padding-left: 22px;
    margin: 0 0 18px;
  }
  .compare-body-inner :global(li) {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-secondary);
    margin-bottom: 8px;
  }
  .compare-body-inner :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-primary);
  }
  /* Clear any inherited background on code inside fenced blocks so Shiki's
     theme shows through without a doubled layer. */
  .compare-body-inner :global(pre code) {
    background: transparent;
  }
  /* Style prose links but exclude button-style anchors (.btn-primary/-secondary/-accent) */
  .compare-body-inner :global(a:not([class*="btn-"])) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .compare-body-inner :global(a:not([class*="btn-"]):hover) {
    text-decoration-thickness: 2px;
  }

  .compare-body-inner :global(.compare-inline-cta) {
    display: flex;
    justify-content: flex-start;
    margin: 24px 0 8px;
  }

  /* ─── Mobile sticky bottom CTA bar ─── */
  .compare-mobile-cta {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 56px;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    z-index: 40;
    /* Fade in via JS after hero scrolls past, but render hidden by default */
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s;
  }

  .compare-mobile-cta.visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* Hidden on desktop */
  @media (min-width: 820px) {
    .compare-mobile-cta {
      display: none;
    }
  }
</style>

<script>
  // Show mobile sticky CTA bar after user scrolls past the hero
  const mobileCta = document.querySelector<HTMLElement>('.compare-mobile-cta');
  const hero = document.getElementById('chero') ?? document.querySelector('header');

  if (mobileCta && hero) {
    const obs = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          mobileCta.classList.remove('visible');
        } else {
          mobileCta.classList.add('visible');
        }
      },
      { threshold: 0 }
    );
    obs.observe(hero);
  }
</script>

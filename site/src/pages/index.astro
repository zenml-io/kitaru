---
import Base from '../layouts/Base.astro';
import WebinarBanner from '../components/WebinarBanner.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ProblemStatement from '../components/ProblemStatement.astro';
import VideoDemo from '../components/VideoDemo.astro';
import OneImport from '../components/OneImport.astro';
import CodeShowcase from '../components/CodeShowcase.astro';
import Features from '../components/Features.astro';
import PlatformBuilder from '../components/PlatformBuilder.astro';
import Architecture from '../components/Architecture.astro';
import Deploy from '../components/Deploy.astro';
import SocialProof from '../components/SocialProof.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <WebinarBanner />
  <Nav />
  <main id="main-content">
    <Hero />
    <VideoDemo />
    <ProblemStatement />
    <OneImport />
    <CodeShowcase />
    <Features />
    <PlatformBuilder />
    <Architecture />
    <Deploy />
    <div class="gradient-divider"></div>
    <SocialProof />
    <div class="gradient-divider"></div>
    <Cta />
  </main>
  <Footer />
</Base>

---
import Base from '../layouts/Base.astro';
import WebinarBanner from '../components/WebinarBanner.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ProblemStatement from '../components/ProblemStatement.astro';
import VideoDemo from '../components/VideoDemo.astro';
import OneImport from '../components/OneImport.astro';
import CodeShowcase from '../components/CodeShowcase.astro';
import Features from '../components/Features.astro';
import Architecture from '../components/Architecture.astro';
import Deploy from '../components/Deploy.astro';
import SocialProof from '../components/SocialProof.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <WebinarBanner />
  <Nav />
  <main id="main-content">
    <!-- 1. Hero (light) — autonomous agents in production -->
    <Hero />
    <!-- 2. Video demo (dark) -->
    <VideoDemo />
    <!-- 3. Problem statement (light) — why autonomous agents fail in production -->
    <ProblemStatement />
    <!-- 4. One-import integration (dark) — OpenAI + Anthropic + PydanticAI + Custom -->
    <OneImport />
    <!-- 5. Code showcase (dark) — full code example with 8 primitives -->
    <CodeShowcase />
    <!-- 6. Features (light) — sticky stacking primitive cards -->
    <Features />
    <!-- 7. Architecture (dark) — the lifecycle layer, positioning -->
    <Architecture />
    <!-- 8. Deploy (light) — kitaru deploy + stacks -->
    <Deploy />
    <div class="gradient-divider"></div>
    <!-- 9. Social proof (light) — ZenML lineage + capabilities -->
    <SocialProof />
    <div class="gradient-divider"></div>
    <!-- 10. CTA -->
    <Cta />
  </main>
  <Footer />
</Base>

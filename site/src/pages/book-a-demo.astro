    pointer-events: none;
  }

  .gs-form-why-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
  }

  .gs-why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-self: center;
  }

  .gs-why-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 28px 20px;
  }

  .gs-why-icon {
    color: var(--color-accent);
    margin-bottom: 16px;

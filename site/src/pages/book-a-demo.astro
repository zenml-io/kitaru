    flex-direction: column;
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  .gs-step-card:hover {
    border-color: oklch(0.60 0.17 45 / 0.3); /* --color-accent-darker @ 30% */
    box-shadow: 0 0 0 3px oklch(0.60 0.17 45 / 0.06); /* --color-accent-darker @ 6% */
  }

  .gs-step-connector {
    display: flex;
    align-items: center;

  @keyframes gs-blob-drift-3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, -50px) scale(0.9); }
  }

  .gs-closing-inner {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .gs-closing h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;

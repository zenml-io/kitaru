{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "files": {
    "includes": [
      "packages/core/**",
      "packages/mastra/**",
      "packages/vercel-ai/**",
      "examples/typescript/mastra_support_triage/**",
      "examples/typescript/vercel_ai_support_triage/**",
      "!packages/core/src/generated/**",
      "!**/dist/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
